@using ManpowerAllocation.Web.Common
@using ManpowerAllocation.Domain.Enums

@*
    Reusable "Outsource by department" panel used on the Summary and every division view. Gives a
    quick, department-wise breakdown of outsource (supply) workers — present and assigned — for the
    selected shift, so a supervisor can see contract cover at a glance without scanning every card.
*@
<div class="sum-panel">
    <div class="sum-panel-head">
        <span class="ico" style="background:var(--mpa-supply)"></span>
        <span class="sum-panel-title">@Title</span>
        <span class="dc-spacer"></span>
        <span class="hint" style="margin:0">@TotalPresent present · @TotalAssigned assigned</span>
    </div>
    <div class="sum-panel-body grid-scroll">
        @if (Rows.Count == 0)
        {
            <p class="recon-empty">No outsource workers @(ShowDivision ? "across the factory" : "in this division") for the selected shift.</p>
        }
        else
        {
            <table class="grid">
                <thead>
                    <tr>
                        @if (ShowDivision)
                        {
                            <th>Division</th>
                        }
                        <th>Department</th>
                        <th class="num">Present</th>
                        <th class="num">Assigned</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Rows)
                    {
                        <tr>
                            @if (ShowDivision)
                            {
                                <td><span class="cell-accent" style="background:@DivAccent(r.Division)"></span>@DivisionLabel(r.Division)</td>
                            }
                            <td class="strong">@TextCase.Title(r.Department)</td>
                            <td class="num @(r.Present > 0 ? "sv-purple" : string.Empty)">@r.Present</td>
                            <td class="num">@r.Total</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="grid-subtotal">
                        <td colspan="@(ShowDivision ? 2 : 1)">Total</td>
                        <td class="num">@TotalPresent</td>
                        <td class="num">@TotalAssigned</td>
                    </tr>
                </tfoot>
            </table>
        }
    </div>
</div>

@code {
    /// <summary>The per-department outsource rows to show, already ordered for display.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<OutsourceRow> Rows { get; set; } = Array.Empty<OutsourceRow>();

    /// <summary>Whether to show the Division column (true on the factory-wide Summary, false on a single division).</summary>
    [Parameter] public bool ShowDivision { get; set; } = true;

    /// <summary>Panel heading.</summary>
    [Parameter] public string Title { get; set; } = "Outsource by department";

    private int TotalPresent => Rows.Sum(r => r.Present);
    private int TotalAssigned => Rows.Sum(r => r.Total);

    private static string DivisionLabel(Division division) => division switch
    {
        Division.Egl => "EGL",
        Division.FunctionalSupport => "Functional Support",
        Division.Brg => "BRG",
        _ => division.ToString()
    };

    private static string DivAccent(Division division) => division switch
    {
        Division.Egl => "var(--mpa-brand)",
        Division.FunctionalSupport => "var(--mpa-teal)",
        Division.Brg => "var(--mpa-magenta)",
        _ => "var(--mpa-brand)"
    };
}
