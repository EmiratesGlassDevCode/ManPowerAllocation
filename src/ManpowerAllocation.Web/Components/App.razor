@*
    Root HTML document for the Blazor Server application. The whole component tree renders
    interactively on the server. All assets are same-origin so the strict Content-Security-Policy
    is satisfied.
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" type="image/png" href="img/emirates-glass-logo.png" />
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />

    @* Shown by the Blazor runtime if the circuit hits an unhandled error; the message is generic. *@
    <div id="blazor-error-ui">
        An unexpected error has occurred.
        <a href="" class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>

    <script src="_framework/blazor.web.js"></script>
</body>
</html>
