@inherits LayoutComponentBase

@*
    Application shell: a top bar showing the signed-in user and a prominent banner whenever the
    session is an emergency break-glass session, plus the primary navigation.
*@
<div class="page">
    <header class="topbar">
        <div class="topbar-brand">
            <img src="img/emirates-glass-logo.svg" alt="Emirates Glass" class="topbar-logo-img" />
            <span class="topbar-title">Manpower Allocation</span>
        </div>
        <div class="topbar-user">
            <AttendanceHealth />
            <AuthorizeView>
                <Authorized>
                    <span class="topbar-name">@context.User.Identity?.Name</span>
                    <form action="/auth/logout" method="post" style="display:inline">
                        <AntiforgeryToken />
                        <button type="submit" class="link-button">Sign out</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>

    <BreakGlassBanner />

    <div class="body">
        <NavMenu />
        <main class="content">
            @Body
        </main>
    </div>
</div>
