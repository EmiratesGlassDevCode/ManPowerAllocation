@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.JSInterop
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* Fluent 2 design system. The mode follows the app's own colour-theme toggle (dark by default);
   the CSS token layer is switched via data-theme on <html> by theme.js, and this keeps the Fluent
   components' own chrome in step. *@
<FluentDesignTheme Mode="_mode" CustomColor="#0F6CBD" />

@*
    Application shell: a responsive top bar showing the signed-in user and a prominent banner
    whenever the session is an emergency break-glass session, plus the primary navigation. On
    phones and tablets the navigation collapses into an off-canvas drawer opened by the menu
    button; it closes automatically after navigation.
*@
<div class="page">
    <header class="topbar">
        <div class="topbar-brand">
            <button class="nav-toggle" type="button" @onclick="ToggleNav" aria-label="Toggle navigation menu">☰</button>
            <span class="logo-plaque"><img src="img/emirates-glass-logo.png" alt="Emirates Glass" /></span>
            <span class="topbar-sub">Manpower Allocation</span>
        </div>
        <div class="topbar-user">
            <button class="theme-toggle" type="button" @onclick="ToggleTheme" title="Toggle light / dark theme" aria-label="Toggle colour theme">@(_isDark ? "☀" : "🌙")</button>
            <AttendanceHealth />
            <AuthorizeView>
                <Authorized>
                    <span class="topbar-name">@context.User.Identity?.Name</span>
                    <span class="topbar-avatar" title="@context.User.Identity?.Name">@Initials(context.User.Identity?.Name)</span>
                    <form action="/auth/logout" method="post" style="display:inline">
                        <AntiforgeryToken />
                        <button type="submit" class="signout-btn">Sign out</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>

    <BreakGlassBanner />

    <div class="body @(_navOpen ? "nav-open" : string.Empty)">
        <NavMenu />
        <div class="nav-backdrop" @onclick="CloseNav"></div>
        <main class="content">
            @Body
        </main>
    </div>
</div>

@* Fluent UI infrastructure providers (dialogs, tooltips, toasts, menus, message bars). *@
<FluentToastProvider />
<FluentDialogProvider />
<FluentTooltipProvider />
<FluentMessageBarProvider />
<FluentMenuProvider />

@code {
    private bool _navOpen;

    // Colour theme. Light is the default; theme.js has already applied the stored choice to
    // <html data-theme> before first paint, and OnAfterRenderAsync reads it back to keep the
    // Fluent component mode in step.
    private DesignThemeModes _mode = DesignThemeModes.Light;
    private bool _isDark;

    /// <summary>Closes the mobile navigation drawer whenever the route changes.</summary>
    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    /// <summary>Reads the persisted colour theme once the circuit is interactive and syncs the Fluent mode.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var theme = await JS.InvokeAsync<string>("mpaTheme.get");
        var isDark = !string.Equals(theme, "light", StringComparison.OrdinalIgnoreCase);
        if (isDark != _isDark)
        {
            _isDark = isDark;
            _mode = isDark ? DesignThemeModes.Dark : DesignThemeModes.Light;
            StateHasChanged();
        }
    }

    /// <summary>Flips the colour theme, updates the Fluent mode and persists the choice via theme.js.</summary>
    private async Task ToggleTheme()
    {
        _isDark = !_isDark;
        _mode = _isDark ? DesignThemeModes.Dark : DesignThemeModes.Light;
        await JS.InvokeVoidAsync("mpaTheme.set", _isDark ? "dark" : "light");
    }

    private void ToggleNav() => _navOpen = !_navOpen;

    private void CloseNav() => _navOpen = false;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_navOpen)
        {
            _navOpen = false;
            InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Unsubscribes from navigation events with the component.</summary>
    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    /// <summary>Derives up-to-two-letter initials from a display name or email for the avatar chip.</summary>
    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        var local = name.Contains('@') ? name[..name.IndexOf('@')] : name;
        var parts = local.Split(new[] { ' ', '.', '_', '-' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
        {
            return "?";
        }

        var first = char.ToUpperInvariant(parts[0][0]);
        if (parts.Length == 1)
        {
            return first.ToString();
        }

        var second = char.ToUpperInvariant(parts[1][0]);
        return $"{first}{second}";
    }
}
