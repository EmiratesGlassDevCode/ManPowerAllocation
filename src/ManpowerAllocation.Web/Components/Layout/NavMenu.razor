@using ManpowerAllocation.Web.Security
@using ManpowerAllocation.Application.Attendance
@using ManpowerAllocation.Application.Departments
@inject AttendanceSyncStatus SyncStatus
@inject DisplayTimeZone Time
@inject IDepartmentService DepartmentService

@*
    Primary navigation. Admin links are only shown to administrators; this is a usability aid,
    not a security control — the Admin pages and their endpoints enforce the role server-side.
    Each item carries a small coloured tile (Fluent app-list style). The footer summarises the
    biometric attendance-sync health.
*@
<nav class="nav">
    <NavLink class="nav-link" href="" Match="NavLinkMatch.All"><span class="nav-ico" style="background:var(--brand)"></span>Summary</NavLink>
    <NavLink class="nav-link" href="division/Egl"><span class="nav-ico" style="background:var(--brand)"></span>EGL@DivisionCount(Division.Egl)</NavLink>
    <NavLink class="nav-link" href="division/FunctionalSupport"><span class="nav-ico" style="background:var(--info)"></span>Functional Support@DivisionCount(Division.FunctionalSupport)</NavLink>
    <NavLink class="nav-link" href="division/Brg"><span class="nav-ico" style="background:var(--magenta)"></span>BRG@DivisionCount(Division.Brg)</NavLink>
    <NavLink class="nav-link" href="search"><span class="nav-ico" style="background:var(--gold)"></span>Employee Search</NavLink>

    <AuthorizeView Policy="@AuthorizationPolicies.RequireAdmin">
        <Authorized>
            <div class="nav-section">Administration</div>
            <NavLink class="nav-link" href="admin/roles"><span class="nav-ico" style="background:var(--brand)"></span>Role Assignments</NavLink>
            <NavLink class="nav-link" href="admin/import"><span class="nav-ico" style="background:var(--info)"></span>Master Data Import</NavLink>
            <NavLink class="nav-link" href="admin/attendance"><span class="nav-ico" style="background:var(--supply)"></span>Attendance Sync</NavLink>
            <NavLink class="nav-link" href="admin/shift-settings"><span class="nav-ico" style="background:var(--gold)"></span>Shift Settings</NavLink>
            <NavLink class="nav-link" href="admin/break-glass"><span class="nav-ico" style="background:var(--danger)"></span>Break-glass Status</NavLink>
            <NavLink class="nav-link" href="admin/audit"><span class="nav-ico" style="background:var(--ok)"></span>Audit Trail</NavLink>
        </Authorized>
    </AuthorizeView>

    <div class="nav-section">System pages</div>
    <NavLink class="nav-link" href="break-glass"><span class="nav-ico" style="background:var(--danger)"></span>Emergency Access</NavLink>
    <NavLink class="nav-link" href="access-denied"><span class="nav-ico" style="background:var(--gold)"></span>Access Denied</NavLink>

    <div class="nav-foot">
        <div class="sync-foot @(_healthy ? string.Empty : "bad")">
            <div class="sync-title">Attendance sync</div>
            <div class="sync-line">@_footLine</div>
        </div>
    </div>
</nav>

@code {
    private bool _healthy;
    private string _footLine = "Waiting for first sync";
    private readonly Dictionary<Division, int> _counts = new();

    /// <summary>Loads the department count per division once for the nav count pills.</summary>
    protected override async Task OnInitializedAsync()
    {
        foreach (var division in new[] { Division.Egl, Division.FunctionalSupport, Division.Brg })
        {
            try
            {
                _counts[division] = (await DepartmentService.GetByDivisionAsync(division)).Count;
            }
            catch
            {
                // A count is a nicety; never let it break the shell.
            }
        }
    }

    /// <summary>Renders the department-count pill for a division link, or nothing when unknown/zero.</summary>
    private MarkupString DivisionCount(Division division) =>
        _counts.TryGetValue(division, out var n) && n > 0
            ? (MarkupString)$"<span class=\"nav-count\">{n}</span>"
            : default;

    /// <summary>Summarises the latest attendance-sync result for the sidebar footer.</summary>
    protected override void OnParametersSet()
    {
        var run = SyncStatus.LastRun;
        if (run is null)
        {
            _healthy = false;
            _footLine = "Waiting for first sync";
        }
        else if (run.Success)
        {
            _healthy = true;
            _footLine = $"Last run {Time.Format(run.RanAtUtc, "HH:mm")} · biometric feed healthy";
        }
        else
        {
            _healthy = false;
            _footLine = $"Last run {Time.Format(run.RanAtUtc, "HH:mm")} · feed unavailable";
        }
    }
}
