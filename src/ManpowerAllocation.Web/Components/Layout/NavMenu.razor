@using ManpowerAllocation.Web.Security
@using ManpowerAllocation.Application.Attendance
@using ManpowerAllocation.Application.Departments
@using Microsoft.Extensions.DependencyInjection
@inject AttendanceSyncStatus SyncStatus
@inject DisplayTimeZone Time
@inject IServiceScopeFactory ScopeFactory

@*
    Primary navigation. Admin links are only shown to administrators; this is a usability aid,
    not a security control — the Admin pages and their endpoints enforce the role server-side.
    Each item carries a small coloured tile (Fluent app-list style). The footer summarises the
    biometric attendance-sync health.
*@
<nav class="nav">
    <NavLink class="nav-link" href="" Match="NavLinkMatch.All"><span class="nav-ico" style="background:var(--mpa-brand)"></span><span class="nav-text">Summary</span></NavLink>
    <NavLink class="nav-link" href="division/Egl"><span class="nav-ico" style="background:var(--mpa-brand)"></span><span class="nav-text">EGL</span>@DivisionCount(Division.Egl)</NavLink>
    <NavLink class="nav-link" href="division/FunctionalSupport"><span class="nav-ico" style="background:var(--mpa-teal)"></span><span class="nav-text">Functional Support</span>@DivisionCount(Division.FunctionalSupport)</NavLink>
    <NavLink class="nav-link" href="division/Brg"><span class="nav-ico" style="background:var(--mpa-magenta)"></span><span class="nav-text">BRG</span>@DivisionCount(Division.Brg)</NavLink>
    <NavLink class="nav-link" href="search"><span class="nav-ico" style="background:var(--mpa-gold)"></span><span class="nav-text">Employee Search</span></NavLink>
    <NavLink class="nav-link" href="history"><span class="nav-ico" style="background:var(--mpa-supply)"></span><span class="nav-text">Report History</span></NavLink>

    <AuthorizeView Policy="@AuthorizationPolicies.RequireAdmin">
        <Authorized>
            <div class="nav-section">Administration</div>
            <NavLink class="nav-link" href="admin/roles"><span class="nav-ico" style="background:var(--mpa-brand)"></span><span class="nav-text">Role Assignments</span></NavLink>
            <NavLink class="nav-link" href="admin/import"><span class="nav-ico" style="background:var(--mpa-teal)"></span><span class="nav-text">Master Data Import</span></NavLink>
            <NavLink class="nav-link" href="admin/cleanup"><span class="nav-ico" style="background:var(--mpa-magenta)"></span><span class="nav-text">Clean Up Departments</span></NavLink>
            <NavLink class="nav-link" href="admin/attendance"><span class="nav-ico" style="background:var(--mpa-supply)"></span><span class="nav-text">Attendance Sync</span></NavLink>
            <NavLink class="nav-link" href="admin/shift-settings"><span class="nav-ico" style="background:var(--mpa-gold)"></span><span class="nav-text">Shift Settings</span></NavLink>
            <NavLink class="nav-link" href="admin/break-glass"><span class="nav-ico" style="background:var(--mpa-danger)"></span><span class="nav-text">Break-glass Status</span></NavLink>
            <NavLink class="nav-link" href="admin/audit"><span class="nav-ico" style="background:var(--mpa-ok)"></span><span class="nav-text">Audit Trail</span></NavLink>
        </Authorized>
    </AuthorizeView>

    <div class="nav-foot">
        <div class="sync-foot @(_healthy ? string.Empty : "bad")">
            <div class="sync-title">Attendance sync</div>
            <div class="sync-line">@_footLine</div>
        </div>
    </div>
</nav>

@code {
    private bool _healthy;
    private string _footLine = "Waiting for first sync";
    private readonly Dictionary<Division, int> _counts = new();

    /// <summary>Loads the department count per division once for the nav count pills.</summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Own scope → own DbContext, so this never races the page's queries.
            using var scope = ScopeFactory.CreateScope();
            var departments = scope.ServiceProvider.GetRequiredService<IDepartmentService>();

            foreach (var division in new[] { Division.Egl, Division.FunctionalSupport, Division.Brg })
            {
                _counts[division] = (await departments.GetByDivisionAsync(division)).Count;
            }
        }
        catch
        {
            // A count is a nicety; never let it break the shell.
        }
    }

    /// <summary>Renders the department-count pill for a division link, or nothing when unknown/zero.</summary>
    private MarkupString DivisionCount(Division division) =>
        _counts.TryGetValue(division, out var n) && n > 0
            ? (MarkupString)$"<span class=\"nav-count\">{n}</span>"
            : default;

    /// <summary>Summarises the latest attendance-sync result for the sidebar footer.</summary>
    protected override void OnParametersSet()
    {
        var run = SyncStatus.LastRun;
        if (run is null)
        {
            _healthy = false;
            _footLine = "Waiting for first sync";
        }
        else if (run.Success)
        {
            _healthy = true;
            _footLine = $"Last run {Time.Format(run.RanAtUtc, "HH:mm")} · biometric feed healthy";
        }
        else
        {
            _healthy = false;
            _footLine = $"Last run {Time.Format(run.RanAtUtc, "HH:mm")} · feed unavailable";
        }
    }
}
