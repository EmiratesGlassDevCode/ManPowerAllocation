@page "/admin/audit"
@using ManpowerAllocation.Application.Auditing
@using ManpowerAllocation.Web.Security
@attribute [Authorize(Policy = AuthorizationPolicies.RequireAdmin)]
@inject IAuditReadService AuditReadService
@inject DisplayTimeZone Time

<PageTitle>Audit Trail — Manpower Allocation</PageTitle>

<h1>Audit Trail</h1>
<p class="hint">
    Every create, update and delete with before → after values. Break-glass sessions are
    highlighted.
</p>

<div class="audit-toolbar">
    <span class="bg-pill @(_breakGlassOnly ? "active" : string.Empty)" @onclick="ToggleBreakGlassOnly">
        <span class="bg-pill-check"></span>
        Show only break-glass sessions
    </span>
    @if (_entries is not null)
    {
        <span class="audit-count">Showing @_entries.Count of @_total most recent entries</span>
    }
</div>

@if (_entries is null)
{
    <p><em>Loading…</em></p>
}
else if (_entries.Count == 0)
{
    <p class="message">No audit entries.</p>
}
else
{
    <div class="data-card audit-card">
        <div class="data-grid audit-cols head">
            <div></div>
            <div>Time (@Time.Name)</div>
            <div>User</div>
            <div>Action</div>
            <div>Entity</div>
            <div>Record</div>
            <div>Break-glass</div>
        </div>
        @foreach (var entry in _entries)
        {
            <div class="data-grid audit-cols row @(entry.IsBreakGlassSession ? "breakglass-row" : string.Empty)"
                 @onclick="() => Toggle(entry.Id)" style="cursor:pointer">
                <div class="audit-caret">@(HasDetail(entry) ? (IsOpen(entry.Id) ? "▾" : "▸") : string.Empty)</div>
                <div>@Time.Format(entry.TimestampUtc, "yyyy-MM-dd HH:mm:ss")</div>
                <div>@(entry.UserDisplayName ?? entry.UserId)</div>
                <div><span class="badge @ActionBadgeClass(entry.Action)">@ActionLabel(entry.Action)</span></div>
                <div>@entry.EntityName</div>
                <div class="data-mono">@entry.RecordId</div>
                <div>@(entry.IsBreakGlassSession ? "YES" : string.Empty)</div>
            </div>
            @if (IsOpen(entry.Id) && HasDetail(entry))
            {
                <div class="audit-detail">
                    @if (!string.IsNullOrWhiteSpace(entry.OldValue))
                    {
                        <div class="audit-col before">
                            <div class="audit-col-title">Before</div>
                            <pre>@Pretty(entry.OldValue)</pre>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(entry.NewValue))
                    {
                        <div class="audit-col after">
                            <div class="audit-col-title">After</div>
                            <pre>@Pretty(entry.NewValue)</pre>
                        </div>
                    }
                </div>
            }
        }
    </div>
}

@code {
    private IReadOnlyList<AuditLogDto>? _entries;
    private bool _breakGlassOnly;
    private int _total;
    private readonly HashSet<long> _open = new();

    /// <summary>Loads the most recent audit entries.</summary>
    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _open.Clear();
        _entries = await AuditReadService.GetRecentAsync(200, _breakGlassOnly);
        if (!_breakGlassOnly)
        {
            _total = _entries.Count;
        }
    }

    private async Task ToggleBreakGlassOnly()
    {
        _breakGlassOnly = !_breakGlassOnly;
        await LoadAsync();
    }

    private bool IsOpen(long id) => _open.Contains(id);

    private void Toggle(long id)
    {
        if (!_open.Remove(id))
        {
            _open.Add(id);
        }
    }

    private static bool HasDetail(AuditLogDto e) =>
        !string.IsNullOrWhiteSpace(e.OldValue) || !string.IsNullOrWhiteSpace(e.NewValue);

    private static string ActionLabel(Domain.Enums.AuditAction action) => action switch
    {
        Domain.Enums.AuditAction.Create => "Create",
        Domain.Enums.AuditAction.Update => "Update",
        Domain.Enums.AuditAction.Delete => "Delete",
        Domain.Enums.AuditAction.SignIn => "Sign in",
        Domain.Enums.AuditAction.SignOut => "Sign out",
        _ => action.ToString()
    };

    /// <summary>Semantic badge colour for an audit action.</summary>
    private static string ActionBadgeClass(Domain.Enums.AuditAction action) => action switch
    {
        Domain.Enums.AuditAction.Create => "b-create",
        Domain.Enums.AuditAction.Update => "b-update",
        Domain.Enums.AuditAction.Delete => "b-delete",
        _ => "b-signevent"
    };

    /// <summary>Pretty-prints stored JSON detail; falls back to the raw text if it is not JSON.</summary>
    private static string Pretty(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(value);
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (System.Text.Json.JsonException)
        {
            return value;
        }
    }
}
