@page "/admin/shift-settings"
@using ManpowerAllocation.Application.Settings
@using ManpowerAllocation.Web.Security
@attribute [Authorize(Policy = AuthorizationPolicies.RequireAdmin)]
@inject IShiftSettingsService ShiftSettingsService
@inject DisplayTimeZone Time

<PageTitle>Shift Settings — Manpower Allocation</PageTitle>

<h1>Shift Settings</h1>
<p class="hint">Define the working shifts and the operational-day boundary.</p>

@if (!_loaded)
{
    <p><em>Loading…</em></p>
}
else
{
    <div class="shift-layout">
        <div class="data-card">
            <div class="sync-card-head warn">
                <span class="ico"></span>
                <span class="sync-card-title">Shift boundaries</span>
            </div>
            <div class="sync-card-body">
                <div class="form-inline">
                    <label>Day shift start
                        <input type="time" @bind="_dayStart" />
                    </label>
                    <label>Night shift start
                        <input type="time" @bind="_nightStart" />
                    </label>
                    <FluentButton Appearance="Appearance.Accent" @onclick="SaveAsync">Save</FluentButton>
                </div>
                <div class="shift-band">
                    <div class="shift-band-day" style="width:@(DayBandPct())%">Day @_dayStart.ToString("HH\\:mm") →</div>
                    <div class="shift-band-night">Night @_nightStart.ToString("HH\\:mm") →</div>
                </div>
                <span class="hint">
                    The day start also sets the operational-day boundary: a night worker who clocks in
                    the evening stays counted present until this time next morning.
                </span>
            </div>
        </div>

        <div class="shift-current">
            <span class="shift-current-title">Current setting</span>
            <span class="shift-current-value">Day @_dayStart.ToString("HH\\:mm") – Night @_nightStart.ToString("HH\\:mm")</span>
            @if (_updatedAtUtc is { } updated)
            {
                <span class="shift-current-sub">Last changed @Time.Format(updated, "yyyy-MM-dd HH:mm") (@Time.Name).</span>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <p class="message @(_isError ? "error" : string.Empty)">@_message</p>
    }
}

@code {
    private bool _loaded;
    private TimeOnly _dayStart = new(7, 0);
    private TimeOnly _nightStart = new(19, 0);
    private DateTime? _updatedAtUtc;
    private string? _message;
    private bool _isError;

    /// <summary>Loads the current shift settings.</summary>
    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var settings = await ShiftSettingsService.GetAsync();
            _dayStart = TimeOnly.FromTimeSpan(settings.DayShiftStart);
            _nightStart = TimeOnly.FromTimeSpan(settings.NightShiftStart);
            _updatedAtUtc = settings.UpdatedAtUtc == default ? null : settings.UpdatedAtUtc;
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _loaded = true;
        }
    }

    /// <summary>Width of the day band as a percentage of the 24h bar (minimum 1 hour).</summary>
    private int DayBandPct()
    {
        var dayHours = (_nightStart.ToTimeSpan() - _dayStart.ToTimeSpan()).TotalHours;
        if (dayHours < 0)
        {
            dayHours += 24;
        }

        return (int)Math.Round(Math.Max(1, dayHours) / 24 * 100);
    }

    private async Task SaveAsync()
    {
        _message = null;
        _isError = false;
        try
        {
            var updated = await ShiftSettingsService.UpdateAsync(
                new UpdateShiftSettingsRequest(_dayStart.ToTimeSpan(), _nightStart.ToTimeSpan()));
            _updatedAtUtc = updated.UpdatedAtUtc;
            _message = "Shift settings saved.";
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
    }
}
