@page "/admin/report-email"
@using ManpowerAllocation.Application.Email
@using ManpowerAllocation.Domain.Enums
@using ManpowerAllocation.Web.Security
@attribute [Authorize(Policy = AuthorizationPolicies.RequireAdmin)]
@inject IEmailSettingsService EmailSettings
@inject EmailSendStatus SendStatus

<PageTitle>Daily Report Email — Manpower Allocation</PageTitle>

<h1>Daily Report Email</h1>
<p class="hint">
    Email the captured day-shift report automatically each day, after the 10:00 cut-off. Configure the
    SMTP server, sender and recipients below. Passwords and client secrets are stored encrypted and are
    never shown again — leave them blank to keep the saved value.
</p>

@if (!_loaded)
{
    <p><em>Loading…</em></p>
}
else
{
    <div class="data-card" style="margin-bottom:16px">
        <div class="kv-card-head"><span class="title">Schedule</span></div>
        <div style="padding:16px; display:flex; flex-direction:column; gap:14px">
            <label class="check">
                <input type="checkbox" @bind="_model.Enabled" />
                Send the daily report email automatically
            </label>
            <div class="form-inline">
                <label>Send at (local)
                    <input type="time" @bind="_sendAt" />
                </label>
                <label class="check">
                    <input type="checkbox" @bind="_model.AttachPdf" />
                    Attach the report PDF
                </label>
            </div>
        </div>
    </div>

    <div class="data-card" style="margin-bottom:16px">
        <div class="kv-card-head"><span class="title">SMTP server</span></div>
        <div style="padding:16px; display:flex; flex-direction:column; gap:14px">
            <div class="form-inline">
                <label>Connection
                    <select @bind="_model.Mode">
                        <option value="@SmtpMode.NoAuth">Local SMTP — no authentication</option>
                        <option value="@SmtpMode.Basic">Local SMTP — username &amp; password</option>
                        <option value="@SmtpMode.Office365Basic">Office 365 — mailbox &amp; app password</option>
                        <option value="@SmtpMode.Office365Modern">Office 365 — modern (OAuth2)</option>
                    </select>
                </label>
                <label>Host / IP
                    <input type="text" @bind="_model.Host" placeholder="e.g. 10.0.0.25 or smtp.office365.com" />
                </label>
                <label>Port
                    <input type="number" min="1" max="65535" @bind="_model.Port" style="width:100px" />
                </label>
                <label>Encryption
                    <select @bind="_model.Security">
                        <option value="@SmtpSecurity.None">None</option>
                        <option value="@SmtpSecurity.StartTls">STARTTLS</option>
                        <option value="@SmtpSecurity.SslOnConnect">SSL/TLS</option>
                    </select>
                </label>
            </div>

            @if (_model.Mode == SmtpMode.Basic || _model.Mode == SmtpMode.Office365Basic)
            {
                <div class="form-inline">
                    <label>Username
                        <input type="text" @bind="_model.Username" placeholder="user@domain or mailbox" />
                    </label>
                    <label>Password
                        <input type="password" @bind="_model.Password" placeholder="@PasswordPlaceholder" autocomplete="new-password" />
                    </label>
                    @if (_current?.PasswordConfigured == true)
                    {
                        <label class="check">
                            <input type="checkbox" @bind="_model.ClearPassword" />
                            Remove saved password
                        </label>
                    }
                </div>
            }

            @if (_model.Mode == SmtpMode.Office365Modern)
            {
                <div class="form-inline">
                    <label>Tenant ID
                        <input type="text" @bind="_model.TenantId" placeholder="directory (tenant) id" />
                    </label>
                    <label>Client ID
                        <input type="text" @bind="_model.ClientId" placeholder="application (client) id" />
                    </label>
                    <label>Sender mailbox
                        <input type="text" @bind="_model.SenderMailbox" placeholder="reports@domain" />
                    </label>
                </div>
                <div class="form-inline">
                    <label>Client secret
                        <input type="password" @bind="_model.ClientSecret" placeholder="@ClientSecretPlaceholder" autocomplete="new-password" />
                    </label>
                    @if (_current?.ClientSecretConfigured == true)
                    {
                        <label class="check">
                            <input type="checkbox" @bind="_model.ClearClientSecret" />
                            Remove saved secret
                        </label>
                    }
                </div>
            }
        </div>
    </div>

    <div class="data-card" style="margin-bottom:16px">
        <div class="kv-card-head"><span class="title">Sender &amp; recipients</span></div>
        <div style="padding:16px; display:flex; flex-direction:column; gap:14px">
            <div class="form-inline">
                <label>From address
                    <input type="email" @bind="_model.FromAddress" placeholder="reports@domain" />
                </label>
                <label>From name
                    <input type="text" @bind="_model.FromName" placeholder="Manpower Allocation" />
                </label>
            </div>
            <label style="display:flex; flex-direction:column; gap:4px">
                To (comma, semicolon or new-line separated)
                <textarea rows="2" @bind="_model.Recipients" placeholder="a@domain, b@domain"></textarea>
            </label>
            <div class="form-inline">
                <label style="display:flex; flex-direction:column; gap:4px">
                    CC
                    <input type="text" @bind="_model.Cc" placeholder="optional" />
                </label>
                <label style="display:flex; flex-direction:column; gap:4px">
                    BCC
                    <input type="text" @bind="_model.Bcc" placeholder="optional" />
                </label>
                <label style="display:flex; flex-direction:column; gap:4px">
                    Reply-To
                    <input type="text" @bind="_model.ReplyTo" placeholder="optional" />
                </label>
            </div>
        </div>
    </div>

    <div class="form-inline" style="margin-bottom:16px">
        <FluentButton Appearance="Appearance.Accent" @onclick="SaveAsync" Disabled="_busy">Save</FluentButton>
        <FluentButton Appearance="Appearance.Neutral" @onclick="SendTestAsync" Disabled="_busy">Send test email</FluentButton>
    </div>

    @if (!string.IsNullOrEmpty(_msg)) { <p class="message ok">@_msg</p> }
    @if (!string.IsNullOrEmpty(_err)) { <p class="message error">@_err</p> }

    <div class="data-card">
        <div class="kv-card-head"><span class="title">Status</span></div>
        <div style="padding:16px">
            <ul class="kv-list">
                <li><span>Last checked</span><span>@Format(SendStatus.LastPollUtc)</span></li>
                <li><span>Last sent</span><span>@Format(SendStatus.LastSuccessUtc)@LastSentDate()</span></li>
                @if (SendStatus.LastFailureUtc is not null)
                {
                    <li><span>Last failure</span><span>@Format(SendStatus.LastFailureUtc) — @SendStatus.LastError</span></li>
                }
            </ul>
        </div>
    </div>
}

@code {
    private bool _loaded;
    private bool _busy;
    private EmailSettingsDto? _current;
    private readonly EditModel _model = new();
    private TimeOnly _sendAt = new(10, 15);

    private string? _msg;
    private string? _err;

    private string PasswordPlaceholder => _current?.PasswordConfigured == true ? "•••••• (unchanged)" : "enter password";
    private string ClientSecretPlaceholder => _current?.ClientSecretConfigured == true ? "•••••• (unchanged)" : "enter client secret";

    /// <summary>Editable form model bound to the inputs.</summary>
    private sealed class EditModel
    {
        public bool Enabled { get; set; }
        public SmtpMode Mode { get; set; } = SmtpMode.NoAuth;
        public string Host { get; set; } = string.Empty;
        public int Port { get; set; } = 587;
        public SmtpSecurity Security { get; set; } = SmtpSecurity.StartTls;
        public string FromAddress { get; set; } = string.Empty;
        public string? FromName { get; set; }
        public string? Username { get; set; }
        public string? Password { get; set; }
        public bool ClearPassword { get; set; }
        public string? TenantId { get; set; }
        public string? ClientId { get; set; }
        public string? ClientSecret { get; set; }
        public bool ClearClientSecret { get; set; }
        public string? SenderMailbox { get; set; }
        public string Recipients { get; set; } = string.Empty;
        public string? Cc { get; set; }
        public string? Bcc { get; set; }
        public string? ReplyTo { get; set; }
        public bool AttachPdf { get; set; } = true;
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _current = await EmailSettings.GetAsync();
            _model.Enabled = _current.Enabled;
            _model.Mode = _current.Mode;
            _model.Host = _current.Host;
            _model.Port = _current.Port;
            _model.Security = _current.Security;
            _model.FromAddress = _current.FromAddress;
            _model.FromName = _current.FromName;
            _model.Username = _current.Username;
            _model.TenantId = _current.TenantId;
            _model.ClientId = _current.ClientId;
            _model.SenderMailbox = _current.SenderMailbox;
            _model.Recipients = _current.Recipients;
            _model.Cc = _current.Cc;
            _model.Bcc = _current.Bcc;
            _model.ReplyTo = _current.ReplyTo;
            _model.AttachPdf = _current.AttachPdf;
            _sendAt = TimeOnly.FromTimeSpan(_current.SendAtLocal);
        }
        catch (Exception ex)
        {
            _err = ex.Message;
        }
        finally
        {
            _loaded = true;
        }
    }

    private async Task SaveAsync()
    {
        _msg = _err = null;
        _busy = true;
        try
        {
            _current = await EmailSettings.UpdateAsync(BuildRequest());
            // Clear write-only fields so a subsequent save does not re-submit them.
            _model.Password = _model.ClientSecret = null;
            _model.ClearPassword = _model.ClearClientSecret = false;
            _msg = "Settings saved.";
        }
        catch (Exception ex)
        {
            _err = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SendTestAsync()
    {
        _msg = _err = null;
        _busy = true;
        try
        {
            // Persist first so the test uses exactly what is on screen.
            _current = await EmailSettings.UpdateAsync(BuildRequest());
            _model.Password = _model.ClientSecret = null;
            _model.ClearPassword = _model.ClearClientSecret = false;
            await EmailSettings.SendTestAsync();
            _msg = "Test email sent to the configured recipients.";
        }
        catch (Exception ex)
        {
            _err = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private UpdateEmailSettingsRequest BuildRequest() => new()
    {
        Enabled = _model.Enabled,
        Mode = _model.Mode,
        Host = _model.Host,
        Port = _model.Port,
        Security = _model.Security,
        FromAddress = _model.FromAddress,
        FromName = _model.FromName,
        Username = _model.Username,
        Password = _model.Password,
        ClearPassword = _model.ClearPassword,
        TenantId = _model.TenantId,
        ClientId = _model.ClientId,
        ClientSecret = _model.ClientSecret,
        ClearClientSecret = _model.ClearClientSecret,
        SenderMailbox = _model.SenderMailbox,
        Recipients = _model.Recipients,
        Cc = _model.Cc,
        Bcc = _model.Bcc,
        ReplyTo = _model.ReplyTo,
        SendAtLocal = _sendAt.ToTimeSpan(),
        AttachPdf = _model.AttachPdf
    };

    private static string Format(DateTime? utc) =>
        utc.HasValue ? utc.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm") : "—";

    private string LastSentDate() =>
        SendStatus.LastSentOperationalDate is { } d ? $" (report {d:yyyy-MM-dd})" : string.Empty;
}
