@page "/admin/department-heads"
@using ManpowerAllocation.Application.Departments
@using ManpowerAllocation.Application.DepartmentHeads
@using ManpowerAllocation.Domain.Enums
@using ManpowerAllocation.Web.Security
@attribute [Authorize(Policy = AuthorizationPolicies.RequireAdmin)]
@inject IDepartmentHeadService HeadService
@inject IDepartmentService DepartmentService

<PageTitle>Department Heads — Manpower Allocation</PageTitle>

<h1>Department Heads</h1>
<p class="hint">
    A department head manages the departments assigned to them — edit required headcount, add/remove
    staff and the daily roster — while seeing the rest of the factory read-only. Enter the person's
    Entra Object ID (from Entra ID → Users, or the Access Denied screen they see), pick their
    departments and save. Clearing all departments removes the headship.
</p>

@if (!_loaded)
{
    <p><em>Loading…</em></p>
}
else
{
    <div class="data-card" style="margin-bottom:16px">
        <div class="kv-card-head"><span class="title">@(string.IsNullOrEmpty(_objId) ? "Appoint a head" : "Edit head")</span></div>
        <div style="padding:16px; display:flex; flex-direction:column; gap:12px">
            <div class="form-inline">
                <label style="display:flex; flex-direction:column; gap:4px">Entra Object ID
                    <input type="text" @bind="_objId" placeholder="00000000-0000-0000-0000-000000000000" style="width:340px" />
                </label>
                <label style="display:flex; flex-direction:column; gap:4px">Display name
                    <input type="text" @bind="_name" placeholder="e.g. Khalid A." style="width:220px" />
                </label>
            </div>

            @foreach (var division in new[] { Division.Egl, Division.FunctionalSupport, Division.Brg })
            {
                var depts = _departments.Where(d => d.Division == division).ToList();
                if (depts.Count == 0) { continue; }
                <div>
                    <div class="strong" style="margin:6px 0">@DivisionLabel(division)</div>
                    <div style="display:flex; flex-wrap:wrap; gap:10px 18px">
                        @foreach (var d in depts)
                        {
                            <label style="display:flex; align-items:center; gap:6px">
                                <input type="checkbox" checked="@_selected.Contains(d.Id)"
                                       @onchange="e => ToggleDept(d.Id, e)" />
                                @TextCase.Title(d.Name)
                            </label>
                        }
                    </div>
                </div>
            }

            <div class="form-inline">
                <FluentButton Appearance="Appearance.Accent" @onclick="SaveAsync" Disabled="_busy">Save</FluentButton>
                @if (!string.IsNullOrEmpty(_objId))
                {
                    <FluentButton Appearance="Appearance.Neutral" @onclick="ResetForm" Disabled="_busy">New</FluentButton>
                }
            </div>
            @if (!string.IsNullOrEmpty(_msg)) { <p class="message ok">@_msg</p> }
            @if (!string.IsNullOrEmpty(_err)) { <p class="message error">@_err</p> }
        </div>
    </div>

    <div class="data-card">
        <div class="kv-card-head"><span class="title">Current heads</span></div>
        <div class="grid-scroll" style="padding:16px">
            @if (_heads.Count == 0)
            {
                <p><em>No department heads assigned yet.</em></p>
            }
            else
            {
                <table class="grid">
                    <thead><tr><th>Name</th><th>Object ID</th><th>Departments</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var h in _heads)
                        {
                            <tr>
                                <td class="strong">@(h.DisplayName ?? "—")</td>
                                <td><code>@h.EntraObjectId</code></td>
                                <td>@string.Join(", ", h.Departments.Select(d => TextCase.Title(d.DepartmentName)))</td>
                                <td style="white-space:nowrap">
                                    <FluentButton Appearance="Appearance.Lightweight" @onclick="() => EditHead(h)">Edit</FluentButton>
                                    <FluentButton Appearance="Appearance.Lightweight" @onclick="() => RevokeAsync(h.EntraObjectId)">Remove</FluentButton>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    private bool _loaded;
    private bool _busy;
    private IReadOnlyList<DepartmentHeadDto> _heads = Array.Empty<DepartmentHeadDto>();
    private List<DepartmentDto> _departments = new();

    private string _objId = string.Empty;
    private string _name = string.Empty;
    private readonly HashSet<int> _selected = new();

    private string? _msg;
    private string? _err;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _departments = new List<DepartmentDto>();
            foreach (var division in new[] { Division.Egl, Division.FunctionalSupport, Division.Brg })
            {
                _departments.AddRange(await DepartmentService.GetByDivisionAsync(division));
            }
            _heads = await HeadService.ListAsync();
        }
        catch (Exception ex)
        {
            _err = ex.Message;
        }
        finally
        {
            _loaded = true;
        }
    }

    private void ToggleDept(int id, ChangeEventArgs e)
    {
        if (e.Value is true) { _selected.Add(id); }
        else { _selected.Remove(id); }
    }

    private void EditHead(DepartmentHeadDto h)
    {
        _objId = h.EntraObjectId;
        _name = h.DisplayName ?? string.Empty;
        _selected.Clear();
        foreach (var d in h.Departments) { _selected.Add(d.DepartmentId); }
        _msg = _err = null;
    }

    private void ResetForm()
    {
        _objId = _name = string.Empty;
        _selected.Clear();
        _msg = _err = null;
    }

    private async Task SaveAsync()
    {
        _msg = _err = null;
        _busy = true;
        try
        {
            await HeadService.UpsertAsync(new UpsertDepartmentHeadRequest
            {
                EntraObjectId = _objId,
                DisplayName = _name,
                DepartmentIds = _selected.ToList()
            });
            _msg = _selected.Count == 0 ? "Headship removed." : "Saved.";
            ResetForm();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _err = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RevokeAsync(string objectId)
    {
        _msg = _err = null;
        _busy = true;
        try
        {
            await HeadService.RevokeAsync(objectId);
            _msg = "Headship removed.";
            if (_objId == objectId) { ResetForm(); }
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _err = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static string DivisionLabel(Division division) => division switch
    {
        Division.Egl => "EGL",
        Division.FunctionalSupport => "Functional Support",
        Division.Brg => "BRG",
        _ => division.ToString()
    };
}
