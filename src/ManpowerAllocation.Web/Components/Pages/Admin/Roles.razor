@page "/admin/roles"
@using ManpowerAllocation.Application.Roles
@using ManpowerAllocation.Web.Security
@attribute [Authorize(Policy = AuthorizationPolicies.RequireAdmin)]
@inject IRoleService RoleService

<PageTitle>Role Assignments — Manpower Allocation</PageTitle>

<h1>Role Assignments</h1>
<p class="hint">
    Grants a role to an Entra ID user by object id. Only this mapping is stored — never a
    credential.
</p>

<div class="data-card roles-form">
    <FluentTextField @bind-Value="_objectId" Label="Entra object id" Placeholder="00000000-0000-0000-0000-000000000000" Style="width:340px" />
    <FluentTextField @bind-Value="_displayName" Label="Display name" Placeholder="Firstname Lastname" Style="width:220px" />
    <label class="native-select-label">Role
        <select @bind="_role">
            @foreach (var role in Enum.GetValues<UserRole>())
            {
                <option value="@role">@role</option>
            }
        </select>
    </label>
    <FluentButton Appearance="Appearance.Accent" @onclick="SaveAsync">Save</FluentButton>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <p class="message @(_messageIsError ? "error" : "ok")">@_message</p>
}

<div class="data-card roles-card">
    <div class="data-grid roles-grid head">
        <div>Display name</div><div>Entra object id</div><div>Role</div><div>Created (UTC)</div><div></div>
    </div>
    @foreach (var assignment in _assignments)
    {
        <div class="data-grid roles-grid row">
            <div class="data-name">
                <span class="emp-av">@Avatar.Initials(assignment.DisplayName)</span>
                <span>@assignment.DisplayName</span>
            </div>
            <div class="data-mono">@assignment.EntraObjectId</div>
            <div>
                <select value="@assignment.Role" @onchange="e => ChangeRoleAsync(assignment, e)">
                    @foreach (var role in Enum.GetValues<UserRole>())
                    {
                        <option value="@role" selected="@(role == assignment.Role)">@role</option>
                    }
                </select>
            </div>
            <div>@assignment.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</div>
            <div><button type="button" class="mini-btn danger" @onclick="() => _removeTarget = assignment">Remove</button></div>
        </div>
    }
</div>

@if (_removeTarget is not null)
{
    <div class="modal-bg" @onclick="() => _removeTarget = null">
        <div class="modal" @onclick:stopPropagation="true">
            <h3>Remove role assignment?</h3>
            <div class="modal-scroll">
                <p>Remove <strong>@(_removeTarget.DisplayName ?? _removeTarget.EntraObjectId)</strong> (@_removeTarget.Role)?
                   They will fall back to the default Viewer access on next sign-in. This is written to the audit trail.</p>
            </div>
            <div class="modal-foot">
                <FluentButton Appearance="Appearance.Neutral" @onclick="() => _removeTarget = null">Cancel</FluentButton>
                <FluentButton Appearance="Appearance.Accent" @onclick="ConfirmRemoveAsync" Disabled="@_busy">Remove</FluentButton>
            </div>
        </div>
    </div>
}

@code {
    private List<RoleAssignmentDto> _assignments = new();
    private RoleAssignmentDto? _removeTarget;
    private bool _busy;

    private async Task ConfirmRemoveAsync()
    {
        if (_removeTarget is null) { return; }
        _busy = true;
        try
        {
            await DeleteAsync(_removeTarget.Id);
            _removeTarget = null;
        }
        finally
        {
            _busy = false;
        }
    }

    private string _objectId = string.Empty;
    private string _displayName = string.Empty;
    private UserRole _role = UserRole.Viewer;
    private string? _message;
    private bool _messageIsError;

    /// <summary>Loads the current assignments.</summary>
    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _assignments = (await RoleService.GetAllAsync()).ToList();
    }

    private async Task SaveAsync()
    {
        _message = null;

        // The Entra object id is a GUID; catch a bad value here with a clear message rather than
        // letting the save fail opaquely.
        if (!Guid.TryParse(_objectId?.Trim(), out _))
        {
            _messageIsError = true;
            _message = "Enter a valid Entra object id (a GUID like 00000000-0000-0000-0000-000000000000).";
            return;
        }

        try
        {
            var saved = await RoleService.UpsertAsync(new UpsertRoleRequest
            {
                EntraObjectId = _objectId,
                DisplayName = _displayName,
                Role = _role
            });
            _messageIsError = false;
            _message = $"Saved {saved.DisplayName ?? saved.EntraObjectId} as {saved.Role}.";
            _objectId = string.Empty;
            _displayName = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            // The service messages here are safe, business-level messages.
            _messageIsError = true;
            _message = ex.Message;
        }
    }

    /// <summary>Changes an existing assignment's role in place from the row's dropdown.</summary>
    private async Task ChangeRoleAsync(RoleAssignmentDto assignment, ChangeEventArgs e)
    {
        if (!Enum.TryParse<UserRole>(e.Value?.ToString(), out var newRole) || newRole == assignment.Role)
        {
            return;
        }

        _message = null;
        try
        {
            await RoleService.UpsertAsync(new UpsertRoleRequest
            {
                EntraObjectId = assignment.EntraObjectId,
                DisplayName = assignment.DisplayName,
                Role = newRole
            });
            _messageIsError = false;
            _message = $"Changed {assignment.DisplayName ?? assignment.EntraObjectId} to {newRole}.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _messageIsError = true;
            _message = ex.Message;
            await LoadAsync(); // reset the dropdown to the actual stored role
        }
    }

    private async Task DeleteAsync(int id)
    {
        _message = null;
        try
        {
            await RoleService.DeleteAsync(id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _messageIsError = true;
            _message = ex.Message;
        }
    }
}
