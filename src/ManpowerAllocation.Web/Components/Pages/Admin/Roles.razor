@page "/admin/roles"
@using ManpowerAllocation.Application.Roles
@using ManpowerAllocation.Web.Security
@attribute [Authorize(Policy = AuthorizationPolicies.RequireAdmin)]
@inject IRoleService RoleService

<PageTitle>Role Assignments — Manpower Allocation</PageTitle>

<h1>Role Assignments</h1>
<p class="hint">
    Grants a role to an Entra ID user by object id. Only this mapping is stored — never a
    credential.
</p>

<div class="data-card roles-form">
    <FluentTextField @bind-Value="_objectId" Label="Entra object id" Placeholder="00000000-0000-0000-0000-000000000000" Style="width:340px" />
    <FluentTextField @bind-Value="_displayName" Label="Display name" Placeholder="Firstname Lastname" Style="width:220px" />
    <label class="native-select-label">Role
        <select @bind="_role">
            @foreach (var role in Enum.GetValues<UserRole>())
            {
                <option value="@role">@role</option>
            }
        </select>
    </label>
    <FluentButton Appearance="Appearance.Accent" @onclick="SaveAsync">Save</FluentButton>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <p class="message">@_message</p>
}

<div class="data-card">
    <div class="data-grid roles-grid head">
        <div>Display name</div><div>Entra object id</div><div>Role</div><div>Created (UTC)</div><div></div>
    </div>
    @foreach (var assignment in _assignments)
    {
        <div class="data-grid roles-grid row">
            <div class="data-name">
                <span class="emp-av">@Avatar.Initials(assignment.DisplayName)</span>
                <span>@assignment.DisplayName</span>
            </div>
            <div class="data-mono">@assignment.EntraObjectId</div>
            <div><span class="badge @RoleBadgeClass(assignment.Role)">@assignment.Role</span></div>
            <div>@assignment.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</div>
            <div><span class="data-remove" @onclick="() => DeleteAsync(assignment.Id)">Remove</span></div>
        </div>
    }
</div>

@code {
    private List<RoleAssignmentDto> _assignments = new();
    private string _objectId = string.Empty;
    private string _displayName = string.Empty;
    private UserRole _role = UserRole.Viewer;
    private string? _message;

    /// <summary>Loads the current assignments.</summary>
    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _assignments = (await RoleService.GetAllAsync()).ToList();
    }

    private async Task SaveAsync()
    {
        _message = null;
        try
        {
            await RoleService.UpsertAsync(new UpsertRoleRequest
            {
                EntraObjectId = _objectId,
                DisplayName = _displayName,
                Role = _role
            });
            _objectId = string.Empty;
            _displayName = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            // The service messages here are safe, business-level messages.
            _message = ex.Message;
        }
    }

    private async Task DeleteAsync(int id)
    {
        _message = null;
        try
        {
            await RoleService.DeleteAsync(id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
    }

    /// <summary>Semantic badge colour for a role: Admin red, User brand, Viewer neutral.</summary>
    private static string RoleBadgeClass(UserRole role) => role switch
    {
        UserRole.Admin => "b-admin",
        UserRole.User => "b-user",
        _ => "b-viewer"
    };
}
