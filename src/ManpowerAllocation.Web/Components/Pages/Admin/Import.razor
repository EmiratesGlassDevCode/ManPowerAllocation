@page "/admin/import"
@using ManpowerAllocation.Application.Import
@using ManpowerAllocation.Web.Security
@attribute [Authorize(Policy = AuthorizationPolicies.RequireAdmin)]
@inject IMasterDataImportService ImportService

<PageTitle>Master Data Import — Manpower Allocation</PageTitle>

<h1>Master Data Import</h1>
<p class="hint">
    One-time seeding of attendance and requirements from Excel. Every import is written to the
    audit trail.
</p>

<div class="import-row">
    <div class="data-card">
        <div class="import-card-head brand"><span class="ico"></span>Attendance workbook</div>
        <div class="import-card-body">
            <span class="hint">Sheets recognised: EGL · Functional Support · BRG.</span>
            <FluentCheckbox @bind-Value="_replaceExisting">
                Replace employees for divisions that already contain data
            </FluentCheckbox>
            <label class="import-drop">
                <span class="import-drop-label">Drop .xlsx here</span>
                <span class="import-drop-or">or</span>
                <span class="import-choose">Choose file</span>
                <span class="import-drop-max">Max 20 MB</span>
                <InputFile OnChange="OnAttendanceSelected" accept=".xlsx" />
            </label>
        </div>
    </div>

    <div class="data-card">
        <div class="import-card-head info"><span class="ico"></span>Requirements workbook</div>
        <div class="import-card-body">
            <span class="hint">Sets day and night required headcount per department.</span>
            <label class="import-drop info">
                <span class="import-drop-label">Drop .xlsx here</span>
                <span class="import-drop-or">or</span>
                <span class="import-choose">Choose file</span>
                <InputFile OnChange="OnRequirementsSelected" accept=".xlsx" />
            </label>
        </div>
    </div>

    @if (_busy)
    {
        <p style="grid-column:1 / -1"><em>Importing…</em></p>
    }

    @if (_result is not null)
    {
        <div class="import-result">
            <span class="import-result-title">Last import result</span>
            <div class="import-stats">
                <div class="import-stat"><b>@_result.DepartmentsCreated</b><span>Departments created</span></div>
                <div class="import-stat"><b>@_result.DepartmentsUpdated</b><span>Departments updated</span></div>
                <div class="import-stat"><b>@_result.EmployeesImported</b><span>Employees imported</span></div>
                <div class="import-stat"><b>@_result.EmployeesRemoved</b><span>Employees removed</span></div>
            </div>
            @foreach (var warning in _result.Warnings)
            {
                <span class="import-warning">@warning</span>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="message error" style="grid-column:1 / -1">@_error</p>
    }
</div>

@code {
    private const long MaxUploadBytes = 20 * 1024 * 1024;

    private bool _replaceExisting;
    private bool _busy;
    private ImportResult? _result;
    private string? _error;

    private Task OnAttendanceSelected(InputFileChangeEventArgs e) =>
        RunImportAsync(stream => ImportService.ImportAttendanceAsync(stream, _replaceExisting), e);

    private Task OnRequirementsSelected(InputFileChangeEventArgs e) =>
        RunImportAsync(stream => ImportService.ImportRequirementsAsync(stream), e);

    private async Task RunImportAsync(Func<Stream, Task<ImportResult>> import, InputFileChangeEventArgs e)
    {
        _result = null;
        _error = null;
        _busy = true;
        try
        {
            // Copy to a seekable in-memory stream: the spreadsheet reader requires random access.
            using var buffer = new MemoryStream();
            await e.File.OpenReadStream(MaxUploadBytes).CopyToAsync(buffer);
            buffer.Position = 0;
            _result = await import(buffer);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
