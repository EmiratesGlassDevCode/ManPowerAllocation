@page "/search"
@using ManpowerAllocation.Application.Employees
@using ManpowerAllocation.Application.Departments
@using ManpowerAllocation.Web.Security
@attribute [Authorize(Policy = AuthorizationPolicies.RequireViewer)]
@inject IEmployeeService EmployeeService
@inject IDepartmentService DepartmentService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Employees — Manpower Allocation</PageTitle>

<h1>Employees</h1>
<p class="hint">The full roster across all divisions. Search, filter, add, edit and remove people. The badge / ID is what links a person to the biometric attendance feed.</p>

<div class="toolbar">
    <FluentSearch @bind-Value="_search" Immediate="true" Placeholder="Name or ID…" Style="width:260px" />
    <label class="native-select-label">Division
        <select @bind="_divisionFilter">
            <option value="">All divisions</option>
            <option value="@Division.Egl">EGL</option>
            <option value="@Division.FunctionalSupport">Functional Support</option>
            <option value="@Division.Brg">BRG</option>
        </select>
    </label>
    <label class="native-select-label">Department
        <select @bind="_deptFilter">
            <option value="">All departments</option>
            @foreach (var group in _departments.GroupBy(d => d.Division))
            {
                <optgroup label="@DivisionLabel(group.Key)">
                    @foreach (var d in group)
                    {
                        <option value="@d.Id">@TextCase.Title(d.Name)</option>
                    }
                </optgroup>
            }
        </select>
    </label>
    <label class="native-select-label">Shift
        <select @bind="_shiftFilter">
            <option value="">Any shift</option>
            <option value="@ShiftType.Day">Day</option>
            <option value="@ShiftType.Night">Night</option>
        </select>
    </label>
    <label class="native-select-label">Status
        <select @bind="_statusFilter">
            <option value="">Any status</option>
            <option value="@AttendanceStatus.Present">Present</option>
            <option value="@AttendanceStatus.Absent">Absent</option>
            <option value="@AttendanceStatus.OnVacation">On vacation</option>
            <option value="supply">Outsource only</option>
            <option value="nobadge">No badge</option>
        </select>
    </label>
    <button type="button" class="mini-btn" @onclick="ClearFilters">Clear</button>
    <span class="toolbar-spacer"></span>
    <a class="link-btn" href="api/exports/attendance" target="_blank"><span class="exp-ico" style="background:var(--mpa-ok)"></span>Excel</a>
    @if (_canEdit)
    {
        <FluentButton Appearance="Appearance.Accent" @onclick="OpenAdd">+ Add employee</FluentButton>
    }
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <p class="message ok">@_message</p>
}

@{
    var rows = Filtered();
}
<p class="hint">@rows.Count of @_all.Count employees</p>

@if (_loading)
{
    <p class="hint">Loading…</p>
}
else if (rows.Count == 0)
{
    <p class="message">No employees match the current filters.</p>
}
else
{
    <div class="grid-scroll">
        <table class="grid">
            <thead>
                <tr>
                    <th>Name</th><th>ID</th><th>Division</th><th>Department</th><th>Shift</th><th>Status</th><th>Notes</th>
                    @if (_canEdit)
                    {
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var e in rows)
                {
                    <tr>
                        <td class="data-name">
                            <span class="emp-av @(e.IsSupply ? "supply" : "status-" + e.Status.ToString().ToLowerInvariant())">@Avatar.Initials(e.Name)</span>
                            <span>@TextCase.Title(e.Name) @(e.IsSupply ? "(OS)" : string.Empty)</span>
                        </td>
                        <td class="@(string.IsNullOrWhiteSpace(e.BadgeNumber) ? "sv-red" : "")">@(string.IsNullOrWhiteSpace(e.BadgeNumber) ? "— none —" : e.BadgeNumber)</td>
                        <td>@DivisionLabel(e.Division)</td>
                        <td>@TextCase.Title(e.DepartmentName)</td>
                        <td><span class="badge @(e.Shift == ShiftType.Day ? "b-day" : "b-night")">@e.Shift</span></td>
                        <td><span class="badge @StatusBadgeClass(e)">@TextCase.Status(e.Status)</span></td>
                        <td class="emp-notes">@(string.IsNullOrWhiteSpace(e.Notes) ? "—" : e.Notes)</td>
                        @if (_canEdit)
                        {
                            <td class="row-actions">
                                <button type="button" class="mini-btn" @onclick="() => OpenEdit(e)">Edit</button>
                                @if (_canDelete)
                                {
                                    <button type="button" class="mini-btn danger" @onclick="() => _deleteTarget = e">Delete</button>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* ── Add employee ─────────────────────────────────────────────────────────── *@
@if (_showAdd)
{
    <div class="modal-bg" @onclick="() => _showAdd = false">
        <div class="modal" @onclick:stopPropagation="true">
            <h3>Add employee</h3>
            <FluentTextField @bind-Value="_aName" Label="Name" Style="width:100%" />
            <FluentTextField @bind-Value="_aBadge" Label="Badge / employee ID" Placeholder="Leave blank if none yet" Style="width:100%" />
            <label class="native-select-label">Department
                <select @bind="_aDeptId">
                    @if (_departments.Count == 0)
                    {
                        <option value="0">No departments — import master data first</option>
                    }
                    @foreach (var group in _departments.GroupBy(d => d.Division))
                    {
                        <optgroup label="@DivisionLabel(group.Key)">
                            @foreach (var d in group)
                            {
                                <option value="@d.Id">@TextCase.Title(d.Name)</option>
                            }
                        </optgroup>
                    }
                </select>
            </label>
            <div class="form-row">
                <label class="native-select-label">Shift
                    <select @bind="_aShift">
                        <option value="@ShiftType.Day">Day</option>
                        <option value="@ShiftType.Night">Night</option>
                    </select>
                </label>
                <label class="native-select-label">Status
                    <select @bind="_aStatus">
                        <option value="@AttendanceStatus.Present">Present</option>
                        <option value="@AttendanceStatus.Absent">Absent</option>
                        <option value="@AttendanceStatus.OnVacation">On vacation</option>
                    </select>
                </label>
            </div>
            <FluentCheckbox @bind-Value="_aSupply">Outsource / supply worker</FluentCheckbox>
            <FluentTextField @bind-Value="_aNotes" Label="Notes / designation" Style="width:100%" />
            @if (!string.IsNullOrEmpty(_addError))
            {
                <p class="message error">@_addError</p>
            }
            <div class="modal-foot">
                <FluentButton Appearance="Appearance.Neutral" @onclick="() => _showAdd = false">Cancel</FluentButton>
                <FluentButton Appearance="Appearance.Accent" @onclick="SaveAddAsync" Disabled="@_busy">Save</FluentButton>
            </div>
        </div>
    </div>
}

@* ── Edit employee ────────────────────────────────────────────────────────── *@
@if (_editTarget is not null)
{
    <div class="modal-bg" @onclick="() => _editTarget = null">
        <div class="modal" @onclick:stopPropagation="true">
            <h3>Edit @TextCase.Title(_editTarget.Name)</h3>
            <FluentTextField @bind-Value="_eName" Label="Name" Style="width:100%" />
            <FluentTextField @bind-Value="_eBadge" Label="Badge / employee ID" Placeholder="The ID must match the biometric feed" Style="width:100%" />
            <label class="native-select-label">Department (@DivisionLabel(_editTarget.Division))
                <select @bind="_eDeptId">
                    @foreach (var d in _departments.Where(d => d.Division == _editTarget.Division))
                    {
                        <option value="@d.Id">@TextCase.Title(d.Name)</option>
                    }
                </select>
            </label>
            <div class="form-row">
                <label class="native-select-label">Shift
                    <select @bind="_eShift">
                        <option value="@ShiftType.Day">Day</option>
                        <option value="@ShiftType.Night">Night</option>
                    </select>
                </label>
                <label class="native-select-label">Status
                    <select @bind="_eStatus">
                        <option value="@AttendanceStatus.Present">Present</option>
                        <option value="@AttendanceStatus.Absent">Absent</option>
                        <option value="@AttendanceStatus.OnVacation">On vacation</option>
                    </select>
                </label>
            </div>
            <FluentTextField @bind-Value="_eNotes" Label="Notes / designation" Style="width:100%" />
            @if (!string.IsNullOrEmpty(_editError))
            {
                <p class="message error">@_editError</p>
            }
            <div class="modal-foot">
                <FluentButton Appearance="Appearance.Neutral" @onclick="() => _editTarget = null">Cancel</FluentButton>
                <FluentButton Appearance="Appearance.Accent" @onclick="SaveEditAsync" Disabled="@_busy">Save</FluentButton>
            </div>
        </div>
    </div>
}

@* ── Delete confirm ───────────────────────────────────────────────────────── *@
@if (_deleteTarget is not null)
{
    <div class="modal-bg" @onclick="() => _deleteTarget = null">
        <div class="modal" @onclick:stopPropagation="true">
            <h3>Remove employee?</h3>
            <div class="modal-scroll">
                <p>Permanently remove <strong>@TextCase.Title(_deleteTarget.Name)</strong>
                   (@(string.IsNullOrWhiteSpace(_deleteTarget.BadgeNumber) ? "no badge" : _deleteTarget.BadgeNumber),
                   @DivisionLabel(_deleteTarget.Division) · @TextCase.Title(_deleteTarget.DepartmentName))?
                   This cannot be undone and is written to the audit trail.</p>
                @if (!string.IsNullOrEmpty(_deleteError))
                {
                    <p class="message error">@_deleteError</p>
                }
            </div>
            <div class="modal-foot">
                <FluentButton Appearance="Appearance.Neutral" @onclick="() => _deleteTarget = null">Cancel</FluentButton>
                <FluentButton Appearance="Appearance.Accent" @onclick="ConfirmDeleteAsync" Disabled="@_busy">Remove</FluentButton>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _busy;
    private string? _message;

    private IReadOnlyList<EmployeeDto> _all = Array.Empty<EmployeeDto>();
    private List<DepartmentDto> _departments = new();
    private bool _canEdit;
    private bool _canDelete;

    // Filters.
    private string _search = string.Empty;
    private string _divisionFilter = string.Empty;
    private string _deptFilter = string.Empty;
    private string _shiftFilter = string.Empty;
    private string _statusFilter = string.Empty;

    private void ClearFilters()
    {
        _search = _divisionFilter = _deptFilter = _shiftFilter = _statusFilter = string.Empty;
    }

    // Add form.
    private bool _showAdd;
    private string _aName = string.Empty;
    private string _aBadge = string.Empty;
    private int _aDeptId;
    private ShiftType _aShift = ShiftType.Day;
    private AttendanceStatus _aStatus = AttendanceStatus.Present;
    private bool _aSupply;
    private string _aNotes = string.Empty;
    private string? _addError;

    // Edit form.
    private EmployeeDto? _editTarget;
    private string _eName = string.Empty;
    private string _eBadge = string.Empty;
    private int _eDeptId;
    private ShiftType _eShift;
    private AttendanceStatus _eStatus;
    private string _eNotes = string.Empty;
    private string? _editError;

    // Delete.
    private EmployeeDto? _deleteTarget;
    private string? _deleteError;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _canEdit = HasRole(authState.User, UserRole.User);
        _canDelete = HasRole(authState.User, UserRole.User);

        foreach (var division in new[] { Division.Egl, Division.FunctionalSupport, Division.Brg })
        {
            _departments.AddRange(await DepartmentService.GetByDivisionAsync(division));
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _all = await EmployeeService.GetAllAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private List<EmployeeDto> Filtered()
    {
        var term = _search.Trim();
        IEnumerable<EmployeeDto> query = _all;

        if (term.Length > 0)
        {
            query = query.Where(e =>
                e.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                || (e.BadgeNumber?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        if (Enum.TryParse<Division>(_divisionFilter, out var division))
        {
            query = query.Where(e => e.Division == division);
        }

        if (int.TryParse(_deptFilter, out var deptId) && deptId > 0)
        {
            query = query.Where(e => e.DepartmentId == deptId);
        }

        if (Enum.TryParse<ShiftType>(_shiftFilter, out var shift))
        {
            query = query.Where(e => e.Shift == shift);
        }

        query = _statusFilter switch
        {
            "supply" => query.Where(e => e.IsSupply),
            "nobadge" => query.Where(e => string.IsNullOrWhiteSpace(e.BadgeNumber)),
            _ when Enum.TryParse<AttendanceStatus>(_statusFilter, out var status) => query.Where(e => e.Status == status),
            _ => query
        };

        return query.ToList();
    }

    // ── Add ──────────────────────────────────────────────────────────────────
    private void OpenAdd()
    {
        _addError = null;
        _message = null;
        _aName = _aBadge = _aNotes = string.Empty;
        _aDeptId = _departments.Count > 0 ? _departments[0].Id : 0;
        _aShift = ShiftType.Day;
        _aStatus = AttendanceStatus.Present;
        _aSupply = false;
        _showAdd = true;
    }

    private async Task SaveAddAsync()
    {
        _addError = null;
        if (string.IsNullOrWhiteSpace(_aName)) { _addError = "Employee name is required."; return; }
        if (_aDeptId <= 0) { _addError = "A department is required."; return; }

        _busy = true;
        try
        {
            var created = await EmployeeService.CreateAsync(new CreateEmployeeRequest
            {
                Name = _aName.Trim(),
                BadgeNumber = string.IsNullOrWhiteSpace(_aBadge) ? null : _aBadge.Trim(),
                DepartmentId = _aDeptId,
                Shift = _aShift,
                Status = _aStatus,
                IsSupply = _aSupply,
                Notes = string.IsNullOrWhiteSpace(_aNotes) ? null : _aNotes.Trim()
            });
            _showAdd = false;
            _message = $"Added {TextCase.Title(created.Name)}.";
            await ReloadAsync();
        }
        catch (Exception ex) { _addError = ex.Message; }
        finally { _busy = false; }
    }

    // ── Edit ─────────────────────────────────────────────────────────────────
    private void OpenEdit(EmployeeDto e)
    {
        _editError = null;
        _message = null;
        _editTarget = e;
        _eName = e.Name;
        _eBadge = e.BadgeNumber ?? string.Empty;
        _eDeptId = e.DepartmentId;
        _eShift = e.Shift;
        _eStatus = e.Status;
        _eNotes = e.Notes ?? string.Empty;
    }

    private async Task SaveEditAsync()
    {
        if (_editTarget is null) { return; }
        _editError = null;
        if (string.IsNullOrWhiteSpace(_eName)) { _editError = "Employee name is required."; return; }

        _busy = true;
        try
        {
            var id = _editTarget.Id;

            await EmployeeService.UpdateAsync(id, new UpdateEmployeeRequest
            {
                Name = _eName.Trim(),
                BadgeNumber = string.IsNullOrWhiteSpace(_eBadge) ? null : _eBadge.Trim(),
                Notes = string.IsNullOrWhiteSpace(_eNotes) ? null : _eNotes.Trim()
            });

            if (_eShift != _editTarget.Shift)
            {
                await EmployeeService.ChangeShiftAsync(id, new ChangeShiftRequest { Shift = _eShift });
            }
            if (_eStatus != _editTarget.Status)
            {
                await EmployeeService.ChangeStatusAsync(id, new ChangeStatusRequest { Status = _eStatus });
            }
            if (_eDeptId != _editTarget.DepartmentId)
            {
                await EmployeeService.MoveAsync(id, new MoveEmployeeRequest { TargetDepartmentId = _eDeptId });
            }

            _editTarget = null;
            _message = $"Updated {TextCase.Title(_eName)}.";
            await ReloadAsync();
        }
        catch (Exception ex) { _editError = ex.Message; }
        finally { _busy = false; }
    }

    // ── Delete ───────────────────────────────────────────────────────────────
    private async Task ConfirmDeleteAsync()
    {
        if (_deleteTarget is null) { return; }
        _deleteError = null;
        _busy = true;
        try
        {
            var name = _deleteTarget.Name;
            await EmployeeService.DeleteAsync(_deleteTarget.Id);
            _deleteTarget = null;
            _message = $"Removed {TextCase.Title(name)}.";
            await ReloadAsync();
        }
        catch (Exception ex) { _deleteError = ex.Message; }
        finally { _busy = false; }
    }

    // ── Helpers ──────────────────────────────────────────────────────────────
    private static string StatusBadgeClass(EmployeeDto e) => e.IsSupply ? "b-supply" : e.Status switch
    {
        AttendanceStatus.Absent => "b-short",
        AttendanceStatus.OnVacation => "b-vac",
        _ => "b-optimal"
    };

    private static string DivisionLabel(Division division) => division switch
    {
        Division.Egl => "EGL",
        Division.FunctionalSupport => "Functional Support",
        Division.Brg => "BRG",
        _ => division.ToString()
    };

    private static bool HasRole(System.Security.Claims.ClaimsPrincipal user, UserRole minimum)
    {
        var raw = user.FindFirst(AppClaimTypes.AppRole)?.Value;
        return Enum.TryParse<UserRole>(raw, out var role) && role >= minimum;
    }
}
