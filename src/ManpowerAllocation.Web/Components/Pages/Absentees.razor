@page "/absentees"
@using ManpowerAllocation.Application.Abstractions
@using ManpowerAllocation.Application.Absences
@using ManpowerAllocation.Application.DepartmentHeads
@using ManpowerAllocation.Application.Settings
@using ManpowerAllocation.Domain.Enums
@using ManpowerAllocation.Web.Common
@using ManpowerAllocation.Web.Security
@attribute [Authorize(Policy = AuthorizationPolicies.RequireViewer)]
@inject IAbsenceService AbsenceService
@inject IAbsenceCategoryService CategoryService
@inject IDepartmentHeadService HeadService
@inject IShiftSettingsService ShiftSettingsService
@inject IFactoryClock FactoryClock
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Absentees — Manpower Allocation</PageTitle>

<h1>Absentees</h1>
<p class="hint">
    Everyone not present — marked <strong>absent</strong> or <strong>on vacation</strong> by the
    attendance sync — plus anyone on planned (Informed) leave covering today. Record why each person is
    away: choose <strong>Informed</strong> with a date range for a communicated absence, or
    <strong>Not Informed</strong> with a comment. An Informed reason automatically drops off this list
    once its period ends.
</p>

<div class="pill-row" style="margin-bottom:12px">
    <button type="button" class="pill @(_division is null ? "active" : "")" @onclick="() => FilterAsync(null)">All</button>
    <button type="button" class="pill @(_division == Division.Egl ? "active" : "")" @onclick="() => FilterAsync(Division.Egl)">EGL</button>
    <button type="button" class="pill @(_division == Division.FunctionalSupport ? "active" : "")" @onclick="() => FilterAsync(Division.FunctionalSupport)">Functional Support</button>
    <button type="button" class="pill @(_division == Division.Brg ? "active" : "")" @onclick="() => FilterAsync(Division.Brg)">BRG</button>
</div>

<div style="display:flex; flex-wrap:wrap; gap:16px; align-items:flex-end; margin-bottom:12px">
    <label style="display:flex; flex-direction:column; gap:4px">Date
        <input type="date" @bind="_asOf" @bind:after="LoadAsync" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
    </label>
    <label style="display:flex; flex-direction:column; gap:4px">Shift
        <select @bind="_shiftKey" @bind:after="LoadAsync">
            <option value="all">All shifts</option>
            <option value="Day">Day</option>
            <option value="Night">Night</option>
        </select>
    </label>
    @if (!_isToday)
    {
        <span class="badge b-vac" style="align-self:center">Historical snapshot · read-only</span>
        <button type="button" class="export-link" @onclick="GoToday">Back to today</button>
    }
</div>

@if (!string.IsNullOrEmpty(_shiftWarning))
{
    <div class="hint" style="color:var(--mpa-gold); margin-bottom:12px">⚠ @_shiftWarning</div>
}

@{
    var rows = Displayed();
}

@if (!_loaded)
{
    <p><em>Loading…</em></p>
}
else
{
    <div class="kpi-row" style="margin-bottom:16px">
        <div class="kpi-tile"><div class="kpi-value">@_items.Count</div><div class="kpi-label">Total away</div></div>
        <div class="kpi-tile"><div class="kpi-value" style="color:var(--mpa-danger)">@CountStatus(AttendanceStatus.Absent)</div><div class="kpi-label">Absent</div></div>
        <div class="kpi-tile"><div class="kpi-value" style="color:var(--mpa-gold)">@CountStatus(AttendanceStatus.OnVacation)</div><div class="kpi-label">On vacation</div></div>
        <div class="kpi-tile"><div class="kpi-value" style="color:var(--mpa-ok)">@CountKind(AbsenceKind.Informed)</div><div class="kpi-label">Informed</div></div>
        <div class="kpi-tile"><div class="kpi-value" style="color:var(--mpa-danger)">@CountKind(AbsenceKind.NotInformed)</div><div class="kpi-label">Not informed</div></div>
        <div class="kpi-tile"><div class="kpi-value" style="color:var(--mpa-brand)">@CountKind(AbsenceKind.Vacation)</div><div class="kpi-label">Vacation</div></div>
        <div class="kpi-tile"><div class="kpi-value">@(_items.Count(i => i.Reason is null))</div><div class="kpi-label">Uncategorized</div></div>
        <div class="kpi-tile"><div class="kpi-value">@(_items.Select(i => i.DepartmentId).Distinct().Count())</div><div class="kpi-label">Departments affected</div></div>
        <div class="kpi-tile"><div class="kpi-value" style="color:var(--mpa-teal)">@ReturningSoon()</div><div class="kpi-label">Returning ≤ tomorrow</div></div>
    </div>

    <div style="display:flex; flex-wrap:wrap; gap:12px; align-items:center; justify-content:space-between; margin-bottom:12px">
        <div class="pill-row">
            <button type="button" class="pill @(_statusFilter == "all" ? "active" : "")" @onclick='() => _statusFilter = "all"'>All</button>
            <button type="button" class="pill @(_statusFilter == "absent" ? "active" : "")" @onclick='() => _statusFilter = "absent"'>Absent</button>
            <button type="button" class="pill @(_statusFilter == "vacation" ? "active" : "")" @onclick='() => _statusFilter = "vacation"'>On vacation</button>
            <button type="button" class="pill @(_statusFilter == "informed" ? "active" : "")" @onclick='() => _statusFilter = "informed"'>Informed</button>
            <button type="button" class="pill @(_statusFilter == "notinformed" ? "active" : "")" @onclick='() => _statusFilter = "notinformed"'>Not informed</button>
            <button type="button" class="pill @(_statusFilter == "vacationkind" ? "active" : "")" @onclick='() => _statusFilter = "vacationkind"'>Vacation</button>
            <button type="button" class="pill @(_statusFilter == "uncat" ? "active" : "")" @onclick='() => _statusFilter = "uncat"'>Uncategorized</button>
        </div>
        <label style="display:flex; align-items:center; gap:6px">Sort
            <select @bind="_sortKey">
                <option value="dept">Department</option>
                <option value="division">Division</option>
                <option value="name">Name</option>
                <option value="badge">Employee ID</option>
                <option value="status">Status</option>
                <option value="reason">Reason</option>
                <option value="head">Department head</option>
                <option value="return">Return date</option>
                <option value="updated">Recently updated</option>
            </select>
            <button type="button" class="export-link" @onclick="() => _sortDesc = !_sortDesc" title="Toggle direction">@(_sortDesc ? "▼" : "▲")</button>
        </label>
    </div>

    @if (rows.Count == 0)
    {
        <div class="data-card"><div style="padding:16px"><em>No absentees to show.</em></div></div>
    }
    else
    {
    <div class="data-card">
        <div class="grid-scroll" style="padding:0">
            <table class="grid">
                <thead>
                    <tr>
                        <th>Employee</th><th>Department</th><th>Dept. head</th><th>Shift</th><th>Status</th><th>Reason</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in rows)
                    {
                        <tr>
                            <td class="strong">
                                @TextCase.Title(item.Name)
                                @if (!string.IsNullOrWhiteSpace(item.BadgeNumber))
                                {
                                    <span class="emp-id" style="opacity:.6;font-weight:400;margin-left:4px">· @item.BadgeNumber</span>
                                }
                                @if (item.IsSupply) { <span class="badge b-vac" style="margin-left:6px">Supply</span> }
                            </td>
                            <td>@TextCase.Title(item.DepartmentName)</td>
                            <td>@(item.DepartmentHead == "Unassigned" ? (MarkupString)"<span class=\"muted\">Unassigned</span>" : (MarkupString)System.Net.WebUtility.HtmlEncode(item.DepartmentHead))</td>
                            <td>@item.Shift</td>
                            <td>@StatusLabel(item.Status)</td>
                            <td>@ReasonMarkup(item.Reason)</td>
                            <td style="white-space:nowrap">
                                @if (_isToday && CanEditDept(item.DepartmentId))
                                {
                                    <FluentButton Appearance="Appearance.Lightweight" @onclick="() => BeginEdit(item)">
                                        @(item.Reason is null ? "Set reason" : "Edit")
                                    </FluentButton>
                                    @if (item.Reason is not null)
                                    {
                                        <FluentButton Appearance="Appearance.Lightweight" @onclick="() => ClearAsync(item)" Disabled="_busy">Clear</FluentButton>
                                    }
                                }
                            </td>
                        </tr>

                        @if (_editingEmployeeId == item.EmployeeId)
                        {
                            <tr class="edit-row">
                                <td colspan="7">
                                    <div style="display:flex; flex-wrap:wrap; gap:12px; align-items:flex-end; padding:8px 4px">
                                        <label style="display:flex; flex-direction:column; gap:4px">Reason
                                            <select @bind="_editCategoryId" style="min-width:220px">
                                                <option value="0">— choose —</option>
                                                <optgroup label="Informed">
                                                    @foreach (var c in _categories.Where(c => c.Kind == AbsenceKind.Informed))
                                                    {
                                                        <option value="@c.Id">@c.Name</option>
                                                    }
                                                </optgroup>
                                                <optgroup label="Vacation">
                                                    @foreach (var c in _categories.Where(c => c.Kind == AbsenceKind.Vacation))
                                                    {
                                                        <option value="@c.Id">@c.Name</option>
                                                    }
                                                </optgroup>
                                                <optgroup label="Not Informed">
                                                    @foreach (var c in _categories.Where(c => c.Kind == AbsenceKind.NotInformed))
                                                    {
                                                        <option value="@c.Id">@c.Name</option>
                                                    }
                                                </optgroup>
                                            </select>
                                        </label>

                                        @if (SelectedKind is AbsenceKind.Informed or AbsenceKind.Vacation)
                                        {
                                            <label style="display:flex; flex-direction:column; gap:4px">From
                                                <input type="date" @bind="_editFrom" />
                                            </label>
                                            <label style="display:flex; flex-direction:column; gap:4px">To
                                                <input type="date" @bind="_editTo" />
                                            </label>
                                        }

                                        <label style="display:flex; flex-direction:column; gap:4px; flex:1; min-width:220px">Comment
                                            <input type="text" @bind="_editComment" placeholder="@(SelectedKind == AbsenceKind.NotInformed ? "Reason / note" : "Optional note")" />
                                        </label>

                                        <FluentButton Appearance="Appearance.Accent" @onclick="() => SaveAsync(item)" Disabled="_busy">Save</FluentButton>
                                        <FluentButton Appearance="Appearance.Neutral" @onclick="CancelEdit" Disabled="_busy">Cancel</FluentButton>
                                    </div>
                                    @if (!string.IsNullOrEmpty(_editErr)) { <p class="message error" style="margin:4px">@_editErr</p> }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    }
}

@if (!string.IsNullOrEmpty(_msg)) { <p class="message ok">@_msg</p> }
@if (!string.IsNullOrEmpty(_err)) { <p class="message error">@_err</p> }

@code {
    private bool _loaded;
    private bool _busy;
    private bool _canEdit;   // User+ globally
    private Division? _division;
    private string _statusFilter = "all";
    private string _sortKey = "dept";
    private bool _sortDesc;
    private DateTime _asOf = DateTime.Today;
    private string _shiftKey = "all";
    private bool _nightStarted;      // true once the current local time is in the night window
    private string? _shiftWarning;

    private bool _isToday => _asOf.Date == DateTime.Today;

    private IReadOnlyList<AbsenceListItemDto> _items = Array.Empty<AbsenceListItemDto>();
    private IReadOnlyList<AbsenceCategoryDto> _categories = Array.Empty<AbsenceCategoryDto>();
    private readonly HashSet<int> _managedDeptIds = new();

    private int? _editingEmployeeId;
    private int _editCategoryId;
    private DateOnly _editFrom = DateOnly.FromDateTime(DateTime.Now);
    private DateOnly _editTo = DateOnly.FromDateTime(DateTime.Now);
    private string _editComment = string.Empty;
    private string? _editErr;

    private string? _msg;
    private string? _err;

    private AbsenceKind? SelectedKind =>
        _categories.FirstOrDefault(c => c.Id == _editCategoryId)?.Kind;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _canEdit = HasRole(authState.User, UserRole.User);
            var isAdmin = HasRole(authState.User, UserRole.Admin);

            _managedDeptIds.Clear();
            // Only a department head needs the managed-department list; Users/Admins can edit anywhere.
            if (!_canEdit && !isAdmin)
            {
                foreach (var id in await HeadService.GetManagedDepartmentIdsAsync())
                {
                    _managedDeptIds.Add(id);
                }
            }

            _categories = await CategoryService.ListAsync(includeInactive: false);

            // Default today's view to the live shift; "All" is intended for after the night shift starts.
            var shiftSettings = await ShiftSettingsService.GetAsync();
            var now = FactoryClock.LocalNow.TimeOfDay;
            var inDayWindow = now >= shiftSettings.DayShiftStart && now < shiftSettings.NightShiftStart;
            _nightStarted = !inDayWindow;
            _shiftKey = inDayWindow ? "Day" : "Night";
        }
        catch (Exception ex)
        {
            _err = ex.Message;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var shift = _shiftKey switch
            {
                "Day" => (ShiftType?)ShiftType.Day,
                "Night" => ShiftType.Night,
                _ => null
            };
            var asOf = DateOnly.FromDateTime(_asOf);
            _items = await AbsenceService.GetAbsenteesAsync(_division, asOf, shift);
            if (!_isToday) { CancelEdit(); }

            // Warn when viewing "All shifts" today before the night shift has started — night data
            // does not exist yet, so the "All" view is only day-shift data at this point.
            _shiftWarning = (_isToday && _shiftKey == "all" && !_nightStarted)
                ? "Night shift hasn’t started yet — “All shifts” shows day-shift data only so far."
                : null;
        }
        catch (Exception ex)
        {
            _err = ex.Message;
        }
        finally
        {
            _loaded = true;
        }
    }

    private async Task GoToday()
    {
        _asOf = DateTime.Today;
        _shiftKey = _nightStarted ? "Night" : "Day";
        await LoadAsync();
    }

    private async Task FilterAsync(Division? division)
    {
        _division = division;
        CancelEdit();
        await LoadAsync();
    }

    private void BeginEdit(AbsenceListItemDto item)
    {
        _editErr = _msg = _err = null;
        _editingEmployeeId = item.EmployeeId;
        if (item.Reason is { } r)
        {
            _editCategoryId = r.CategoryId;
            _editFrom = r.FromDate;
            _editTo = r.ToDate ?? r.FromDate;
            _editComment = r.Comment ?? string.Empty;
        }
        else
        {
            _editCategoryId = 0;
            _editFrom = _editTo = DateOnly.FromDateTime(DateTime.Now);
            _editComment = string.Empty;
        }
    }

    private void CancelEdit()
    {
        _editingEmployeeId = null;
        _editErr = null;
    }

    private async Task SaveAsync(AbsenceListItemDto item)
    {
        _editErr = null;
        if (_editCategoryId == 0) { _editErr = "Choose a reason."; return; }

        _busy = true;
        try
        {
            var hasDates = SelectedKind is AbsenceKind.Informed or AbsenceKind.Vacation;
            await AbsenceService.SetReasonAsync(new SetAbsenceReasonRequest
            {
                EmployeeId = item.EmployeeId,
                CategoryId = _editCategoryId,
                FromDate = hasDates ? _editFrom : null,
                ToDate = hasDates ? _editTo : null,
                Comment = string.IsNullOrWhiteSpace(_editComment) ? null : _editComment
            });
            _msg = $"Reason recorded for {item.Name}.";
            CancelEdit();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _editErr = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ClearAsync(AbsenceListItemDto item)
    {
        _msg = _err = null;
        _busy = true;
        try
        {
            await AbsenceService.ClearReasonAsync(item.EmployeeId);
            _msg = $"Reason cleared for {item.Name}.";
            if (_editingEmployeeId == item.EmployeeId) { CancelEdit(); }
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _err = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private MarkupString ReasonMarkup(AbsenceReasonView? reason)
    {
        if (reason is null)
        {
            return (MarkupString)"<span class=\"muted\">—</span>";
        }

        var kind = AbsenceKindText.Label(reason.Kind);
        var cls = reason.Kind switch
        {
            AbsenceKind.Informed => "abs-informed",
            AbsenceKind.Vacation => "abs-vacation",
            _ => "abs-not-informed"
        };
        var text = $"<span class=\"badge {cls}\">{kind}</span> {System.Net.WebUtility.HtmlEncode(reason.CategoryName)}";

        if (AbsenceKindText.HasDateRange(reason.Kind))
        {
            var to = reason.ToDate?.ToString("dd MMM") ?? "—";
            text += $" <span class=\"muted\">({reason.FromDate:dd MMM} – {to})</span>";
        }

        if (!string.IsNullOrWhiteSpace(reason.Comment))
        {
            text += $" <span class=\"muted\">· {System.Net.WebUtility.HtmlEncode(reason.Comment)}</span>";
        }

        return (MarkupString)text;
    }

    private static string StatusLabel(AttendanceStatus status) => status switch
    {
        AttendanceStatus.Present => "Present",
        AttendanceStatus.Absent => "Absent",
        AttendanceStatus.OnVacation => "On vacation",
        _ => status.ToString()
    };

    private int CountStatus(AttendanceStatus status) => _items.Count(i => i.Status == status);

    private int CountKind(AbsenceKind kind) => _items.Count(i => i.Reason is not null && i.Reason.Kind == kind);

    /// <summary>Count of Informed leaves whose return (To) date is today or tomorrow.</summary>
    private int ReturningSoon()
    {
        var today = DateOnly.FromDateTime(DateTime.Now);
        var tomorrow = today.AddDays(1);
        return _items.Count(i => i.Reason?.ToDate is { } d && d >= today && d <= tomorrow);
    }

    /// <summary>Applies the status/reason quick-filter and the chosen sort to the loaded list.</summary>
    private IReadOnlyList<AbsenceListItemDto> Displayed()
    {
        IEnumerable<AbsenceListItemDto> q = _items;
        q = _statusFilter switch
        {
            "absent" => q.Where(i => i.Status == AttendanceStatus.Absent),
            "vacation" => q.Where(i => i.Status == AttendanceStatus.OnVacation),
            "informed" => q.Where(i => i.Reason is not null && i.Reason.Kind == AbsenceKind.Informed),
            "notinformed" => q.Where(i => i.Reason is not null && i.Reason.Kind == AbsenceKind.NotInformed),
            "vacationkind" => q.Where(i => i.Reason is not null && i.Reason.Kind == AbsenceKind.Vacation),
            "uncat" => q.Where(i => i.Reason is null),
            _ => q
        };

        Func<AbsenceListItemDto, object> key = _sortKey switch
        {
            "division" => i => i.Division,
            "name" => i => i.Name,
            "badge" => i => i.BadgeNumber ?? string.Empty,
            "status" => i => (int)i.Status,
            "head" => i => i.DepartmentHead,
            "reason" => i => i.Reason is null ? 99 : (int)i.Reason.Kind,
            "return" => i => i.Reason?.ToDate?.DayNumber ?? int.MaxValue,
            "updated" => i => i.Reason?.SetAtUtc ?? DateTime.MinValue,
            _ => i => i.DepartmentName
        };

        var ordered = _sortDesc ? q.OrderByDescending(key) : q.OrderBy(key);
        return ordered.ThenBy(i => i.Name).ToList();
    }

    private bool CanEditDept(int departmentId) => _canEdit || _managedDeptIds.Contains(departmentId);

    private static bool HasRole(System.Security.Claims.ClaimsPrincipal user, UserRole minimum)
    {
        var raw = user.FindFirst(AppClaimTypes.AppRole)?.Value;
        return Enum.TryParse<UserRole>(raw, out var role) && RoleRank.RankOf(role) >= RoleRank.RankOf(minimum);
    }
}
