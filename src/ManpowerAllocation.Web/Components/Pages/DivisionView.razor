@page "/division/{DivisionName}"
@using ManpowerAllocation.Application.Dashboard
@using ManpowerAllocation.Application.Departments
@using ManpowerAllocation.Application.Employees
@using ManpowerAllocation.Application.Shifts
@using ManpowerAllocation.Web.Security
@attribute [Authorize(Policy = AuthorizationPolicies.RequireViewer)]
@inject IDashboardService DashboardService
@inject IEmployeeService EmployeeService
@inject IDepartmentService DepartmentService
@inject IShiftScheduleService ScheduleService
@inject ManpowerAllocation.Application.DepartmentHeads.IDepartmentHeadService HeadService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@_label — Manpower Allocation</PageTitle>

@if (_division is null)
{
    <h1>Unknown division</h1>
    <p>The requested division does not exist.</p>
}
else
{
    <div class="screen-head">
        <div class="screen-head-block">
            <div class="breadcrumb">Home / Departments</div>
            <h1>@_label</h1>
        </div>
        <ShiftSelector Value="_shift" ValueChanged="OnShiftChanged" />
    </div>

    @if (!string.IsNullOrEmpty(_actionError))
    {
        <p class="message error">@_actionError</p>
    }

    @if (_dashboard is null)
    {
        <p><em>Loading…</em></p>
    }
    else
    {
        var t = _dashboard.Totals;
        @if (_shift == ShiftFilter.All)
        {
            <p class="hint">
                “All” combines day and night over a 24-hour cycle, so <b>Absent</b> includes the shift
                that isn’t on the floor now. For shift-accurate absence, choose <b>Day</b> or <b>Night</b>.
            </p>
        }
        <div class="kpi-row">
            <div class="kpi k-blue"><div class="kpi-lbl">Present</div><div class="kpi-val">@t.TotalPresent</div><div class="kpi-sub">on floor now</div></div>
            <div class="kpi k-neutral"><div class="kpi-lbl">Required</div><div class="kpi-val">@t.Required</div><div class="kpi-sub">planned</div></div>
            <div class="kpi k-teal"><div class="kpi-lbl">On roll</div><div class="kpi-val">@t.OnRoll</div><div class="kpi-sub">assigned</div></div>
            <div class="kpi k-red"><div class="kpi-lbl">Absent</div><div class="kpi-val @(t.Absent > 0 ? "sv-red" : string.Empty)">@t.Absent</div><div class="kpi-sub">unplanned</div></div>
            <div class="kpi k-amber"><div class="kpi-lbl">Vacation</div><div class="kpi-val @(t.OnVacation > 0 ? "sv-amber" : string.Empty)">@t.OnVacation</div><div class="kpi-sub">approved leave</div></div>
            <div class="kpi k-purple"><div class="kpi-lbl">Outsource</div><div class="kpi-val">@t.SupplyPresent</div><div class="kpi-sub">contract cover</div></div>
            <div class="kpi @(t.Variance < 0 ? "k-red" : "k-green")"><div class="kpi-lbl">Variance</div><div class="kpi-val @(t.Variance < 0 ? "sv-red" : "sv-green")">@Signed(t.Variance)</div><div class="kpi-sub">vs. required</div></div>
            <div class="kpi @(t.ShortageDepartmentCount > 0 ? "k-red" : "k-neutral")"><div class="kpi-lbl">Short depts</div><div class="kpi-val @(t.ShortageDepartmentCount > 0 ? "sv-red" : string.Empty)">@t.ShortageDepartmentCount</div><div class="kpi-sub">need cover</div></div>
        </div>

        <div class="toolbar">
            <FluentSearch @bind-Value="_search" Immediate="true" Placeholder="Search department or person…" />
            <div class="pill-row">
                <button type="button" class="pill @(_filter == "all" ? "active" : string.Empty)" @onclick='() => _filter = "all"'>All</button>
                <button type="button" class="pill @(_filter == "short" ? "active" : string.Empty)" @onclick='() => _filter = "short"'>Shortage</button>
                <button type="button" class="pill @(_filter == "excess" ? "active" : string.Empty)" @onclick='() => _filter = "excess"'>Excess</button>
                <button type="button" class="pill @(_filter == "ok" ? "active" : string.Empty)" @onclick='() => _filter = "ok"'>Optimal</button>
                <button type="button" class="pill @(_filter == "off" ? "active" : string.Empty)" @onclick='() => _filter = "off"'>OFF</button>
            </div>
            <span class="dc-spacer"></span>
            @if (_canEdit)
            {
                <FluentButton Appearance="Appearance.Neutral" @onclick="() => ToggleAllAsync(true)">All ON</FluentButton>
                <FluentButton Appearance="Appearance.Neutral" @onclick="() => ToggleAllAsync(false)">All OFF</FluentButton>
            }
            @if (_canAdmin)
            {
                <FluentButton Appearance="Appearance.Accent" @onclick="OpenAddDept">+ Add department</FluentButton>
            }
        </div>

        <div class="dept-grid">
            @foreach (var dept in VisibleDepartments())
            {
                var presentPct = dept.Required > 0 ? Math.Min((int)Math.Round(dept.Present * 100.0 / dept.Required), 100) : (dept.Present > 0 ? 100 : 0);
                var supplyPct = dept.Required > 0 ? Math.Min((int)Math.Round(dept.SupplyPresent * 100.0 / dept.Required), 100 - presentPct) : 0;
                <div class="dept-card status-@(dept.Status.ToString().ToLowerInvariant())">
                    <div class="dept-card-head">
                        <span class="dept-ico" style="background:@DeptAccent(dept.DepartmentId)">@Avatar.Initials(dept.Name)</span>
                        <div class="dept-head-text">
                            <div class="dept-name" @onclick="() => OpenDeptModal(dept)">@TextCase.Title(dept.Name)</div>
                            <div class="dept-sub">@dept.OnRoll on roll · @ShiftText()</div>
                        </div>
                        @if (CanEditDept(dept.DepartmentId))
                        {
                            <FluentSwitch Value="@dept.IsActive"
                                          ValueChanged="v => ToggleDepartmentAsync(dept.DepartmentId, v)"
                                          title="Active" />
                        }
                    </div>
                    <div class="dept-card-body">
                        <div class="dc-row"><span class="dc-lbl">Present / Required</span><span class="dc-val">@dept.TotalPresent / @dept.Required</span></div>
                        <div class="bar">
                            <div class="bar-fill fill-@(dept.Status.ToString().ToLowerInvariant())" style="width:@(presentPct)%"></div>
                            @if (dept.SupplyPresent > 0)
                            {
                                <div class="bar-supply" style="width:@(supplyPct)%" title="Outsource cover"></div>
                            }
                        </div>
                        <div class="badges">
                            <span class="badge b-@(dept.Status.ToString().ToLowerInvariant())">@StatusLabel(dept)</span>
                            @if (dept.OnVacation > 0) { <span class="badge b-vac">Vacation @dept.OnVacation</span> }
                            @if (dept.Absent > 0) { <span class="badge b-short">Absent @dept.Absent</span> }
                            @if (dept.SupplyPresent > 0) { <span class="badge b-supply">Outsource @dept.SupplyPresent</span> }
                        </div>

                        <div class="dc-actions">
                            <span class="link" @onclick="() => ToggleExpand(dept.DepartmentId)">
                                @(IsExpanded(dept.DepartmentId) ? "Hide roster" : "Show roster")
                            </span>
                            <span class="dc-spacer"></span>
                            @if (CanManageDept(dept.DepartmentId))
                            {
                                <FluentButton Appearance="Appearance.Neutral" @onclick="() => OpenEditDept(dept.DepartmentId)">Edit</FluentButton>
                            }
                            @if (_canAdmin)
                            {
                                <FluentButton Appearance="Appearance.Neutral" @onclick="() => _deleteDeptTarget = dept">Delete</FluentButton>
                            }
                        </div>

                        @if (IsExpanded(dept.DepartmentId) && _byDept.TryGetValue(dept.DepartmentId, out var members))
                        {
                            <ul class="emp-list">
                                @foreach (var emp in members)
                                {
                                    <li class="emp-row">
                                        <span class="emp-av @(emp.IsSupply ? "supply" : "status-" + emp.Status.ToString().ToLowerInvariant())">@Avatar.Initials(emp.Name)</span>
                                        <span class="emp-name">@TextCase.Title(emp.Name) @(emp.IsSupply ? "(OS)" : string.Empty)@if (!string.IsNullOrWhiteSpace(emp.BadgeNumber))
                                            {<span class="emp-id" style="opacity:.6;font-weight:400;margin-left:4px">· @emp.BadgeNumber</span>}</span>
                                        <span class="emp-shift shift-@emp.Shift.ToString().ToLowerInvariant()">@emp.Shift</span>
                                        <span class="emp-status status-@(emp.Status.ToString().ToLowerInvariant())">@TextCase.Status(emp.Status)</span>
                                        @if (CanEditDept(dept.DepartmentId))
                                        {
                                            <span class="emp-actions">
                                                @* Vacation is an own-staff concept; outsource/supply presence is managed differently. *@
                                                @if (!emp.IsSupply)
                                                {
                                                    @if (emp.Status == AttendanceStatus.OnVacation)
                                                    {
                                                        <FluentButton Appearance="Appearance.Lightweight" @onclick="() => SetStatusAsync(emp.Id, AttendanceStatus.Absent)">Unmark vac</FluentButton>
                                                    }
                                                    else
                                                    {
                                                        <FluentButton Appearance="Appearance.Lightweight" @onclick="() => SetStatusAsync(emp.Id, AttendanceStatus.OnVacation)">Mark vac</FluentButton>
                                                    }
                                                }
                                                <FluentButton Appearance="Appearance.Lightweight" @onclick="() => ChangeShiftAsync(emp.Id, emp.Shift == ShiftType.Day ? ShiftType.Night : ShiftType.Day)">↔ Shift</FluentButton>
                                                <select class="move-select" @onchange="e => MoveAsync(emp.Id, e.Value?.ToString())">
                                                    <option value="0">Loan to…</option>
                                                    @if (_pools.Any(p => p.Id == emp.DepartmentId))
                                                    {
                                                        @* In a shared pool (Excess / Outsource): can be sent back to any division's department. *@
                                                        @foreach (var grp in _allDepartments.Where(d => !d.IsPool && d.Id != emp.DepartmentId).GroupBy(d => d.Division))
                                                        {
                                                            <optgroup label="@DivisionLabel(grp.Key)">
                                                                @foreach (var d in grp)
                                                                {
                                                                    <option value="@d.Id">@TextCase.Title(d.Name)</option>
                                                                }
                                                            </optgroup>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        @foreach (var d in _departments.Where(d => !d.IsPool && d.Id != emp.DepartmentId))
                                                        {
                                                            <option value="@d.Id">@TextCase.Title(d.Name)</option>
                                                        }
                                                    }
                                                    @if (_pools.Any(p => p.Id != emp.DepartmentId))
                                                    {
                                                        <optgroup label="Pools">
                                                            @foreach (var p in _pools.Where(p => p.Id != emp.DepartmentId))
                                                            {
                                                                <option value="@p.Id">@TextCase.Title(p.Name)</option>
                                                            }
                                                        </optgroup>
                                                    }
                                                </select>
                                            </span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="alert-row">
            <AlertPanel Title="Absent" Accent="red" Items="AbsentList()" />
            <AlertPanel Title="On vacation" Accent="amber" Items="VacationList()" />
            <AlertPanel Title="Outsource present" Accent="purple" Items="OutsourceList()" />
            <AlertPanel Title="Outsource by department" Accent="purple" Items="_outsourceByDept" />
            <AlertPanel Title="Available / excess" Accent="cyan" Items="ExcessList()" />
        </div>
    }
}

@if (_showDeptForm)
{
    <div class="modal-bg" @onclick="CloseDeptForm">
        <div class="modal" @onclick:stopPropagation="true">
            <h3>@(_editingId is null ? "Add department" : "Edit department")</h3>
            @* Plain HTML inputs (not Fluent web components) so the fields are always editable. *@
            <label style="display:flex; flex-direction:column; gap:4px">Name
                <input type="text" @bind="_fName" disabled="@(_editingId is not null)" style="width:100%" />
            </label>
            <div class="form-row" style="display:flex; gap:12px; margin-top:8px">
                <label style="display:flex; flex-direction:column; gap:4px">Day required
                    <input type="number" min="0" step="1" @bind="_fReqDay" style="width:110px" />
                </label>
                <label style="display:flex; flex-direction:column; gap:4px">Night required
                    <input type="number" min="0" step="1" @bind="_fReqNight" style="width:110px" />
                </label>
                <label style="display:flex; flex-direction:column; gap:4px">Sequence
                    <input type="number" step="0.5" @bind="_fSeq" style="width:110px" />
                </label>
            </div>
            <label style="display:flex; flex-direction:column; gap:4px; margin-top:8px">Shift schedule
                <select @bind="_fScheduleId">
                    @foreach (var s in _schedules)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
            </label>
            @if (_editingId is not null)
            {
                <label style="display:flex; align-items:center; gap:8px; margin-top:8px">
                    <input type="checkbox" @bind="_fActive" /> Active
                </label>
            }
            @if (!string.IsNullOrEmpty(_formError))
            {
                <p class="message error">@_formError</p>
            }
            <div class="modal-foot">
                <FluentButton Appearance="Appearance.Neutral" @onclick="CloseDeptForm">Cancel</FluentButton>
                <FluentButton Appearance="Appearance.Accent" @onclick="SaveDeptAsync" Disabled="@_busy">Save</FluentButton>
            </div>
        </div>
    </div>
}

@if (_deleteDeptTarget is not null)
{
    var delMembers = _employees.Where(e => e.DepartmentId == _deleteDeptTarget.DepartmentId).ToList();
    var delOwn = delMembers.Count(e => !e.IsSupply);
    var delSupply = delMembers.Count(e => e.IsSupply);
    <div class="modal-bg" @onclick="() => _deleteDeptTarget = null">
        <div class="modal" @onclick:stopPropagation="true">
            <h3>Delete department?</h3>
            <div class="modal-scroll">
                @if (delOwn > 0)
                {
                    <p>Delete <strong>@TextCase.Title(_deleteDeptTarget.Name)</strong>? This department has
                       <strong>@delOwn</strong> own employee(s) allocated. Move them to another department
                       first — own staff are never deleted.</p>
                }
                else if (delSupply > 0)
                {
                    <p>⚠ <strong>@TextCase.Title(_deleteDeptTarget.Name)</strong> holds <strong>@delSupply</strong>
                       outsource/supply member(s). Deleting removes the department <strong>and those @delSupply
                       member(s)</strong>. This cannot be undone and is written to the audit trail.</p>
                }
                else
                {
                    <p>Delete <strong>@TextCase.Title(_deleteDeptTarget.Name)</strong>? This is written to the audit trail.</p>
                }
            </div>
            <div class="modal-foot">
                <FluentButton Appearance="Appearance.Neutral" @onclick="() => _deleteDeptTarget = null">Cancel</FluentButton>
                @if (delOwn > 0)
                {
                    <FluentButton Appearance="Appearance.Accent" Disabled="true">Delete</FluentButton>
                }
                else if (delSupply > 0)
                {
                    <FluentButton Appearance="Appearance.Accent" @onclick="ConfirmDeleteDeptAsync" Disabled="@_busy">Delete department + members</FluentButton>
                }
                else
                {
                    <FluentButton Appearance="Appearance.Accent" @onclick="ConfirmDeleteDeptAsync" Disabled="@_busy">Delete</FluentButton>
                }
            </div>
        </div>
    </div>
}

@if (_modalDept is not null)
{
    <div class="modal-bg" @onclick="() => _modalDept = null">
        <div class="modal wide" @onclick:stopPropagation="true">
            <h3>@TextCase.Title(_modalDept.Name)</h3>
            <div class="kpi-row">
                <div class="kpi"><div class="kpi-val sv-blue">@_modalDept.TotalPresent</div><div class="kpi-lbl">Present</div></div>
                <div class="kpi"><div class="kpi-val">@_modalDept.Required</div><div class="kpi-lbl">Required</div></div>
                <div class="kpi"><div class="kpi-val sv-red">@_modalDept.Absent</div><div class="kpi-lbl">Absent</div></div>
                <div class="kpi"><div class="kpi-val sv-amber">@_modalDept.OnVacation</div><div class="kpi-lbl">Vacation</div></div>
                <div class="kpi"><div class="kpi-val sv-purple">@_modalDept.SupplyPresent</div><div class="kpi-lbl">Outsource</div></div>
            </div>
            @if (_byDept.TryGetValue(_modalDept.DepartmentId, out var mem))
            {
                <table class="grid">
                    <thead><tr><th>Name</th><th>ID</th><th>Shift</th><th>Status</th><th>Notes</th></tr></thead>
                    <tbody>
                        @foreach (var e in mem)
                        {
                            <tr>
                                <td>@TextCase.Title(e.Name) @(e.IsSupply ? "(OS)" : "")</td>
                                <td>@e.BadgeNumber</td>
                                <td>@e.Shift</td>
                                <td class="status-@(e.Status.ToString().ToLowerInvariant())">@TextCase.Status(e.Status)</td>
                                <td>@e.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            <div class="modal-foot">
                <button type="button" @onclick="() => _modalDept = null">Close</button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>The division name from the route.</summary>
    [Parameter]
    public string? DivisionName { get; set; }

    private Division? _division;
    private string _label = string.Empty;
    private ShiftFilter _shift = ShiftFilter.All;
    private bool _shiftInitialised;
    private DivisionDashboard? _dashboard;
    private List<DepartmentDto> _departments = new();
    private List<DepartmentDto> _pools = new();
    private List<DepartmentDto> _allDepartments = new();
    private List<EmployeeDto> _employees = new();
    private Dictionary<int, List<EmployeeDto>> _byDept = new();
    private List<string> _outsourceByDept = new();
    private readonly HashSet<int> _expanded = new();
    private bool _canEdit;
    private bool _canAdmin;
    private readonly HashSet<int> _managedDeptIds = new();
    private string _search = string.Empty;
    private string _filter = "all";

    // Department add/edit form state.
    private bool _showDeptForm;
    private int? _editingId;
    private string _fName = string.Empty;
    private int _fReqDay;
    private int _fReqNight;
    private decimal _fSeq;
    private bool _fActive = true;
    private int _fScheduleId;
    private IReadOnlyList<ShiftScheduleDto> _schedules = Array.Empty<ShiftScheduleDto>();
    private string? _formError;

    // Inline error for row-level actions (status/shift/move/toggle) so a service failure does
    // not tear down the circuit.
    private string? _actionError;

    private DepartmentStats? _modalDept;

    /// <summary>Resolves the division, permissions and initial data.</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (Enum.TryParse<Division>(DivisionName, ignoreCase: true, out var division))
        {
            _division = division;
            _label = division switch
            {
                Division.Egl => "EGL Departments",
                Division.FunctionalSupport => "Functional Support Departments",
                Division.Brg => "BRG Departments",
                _ => division.ToString()
            };

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _canEdit = HasRole(authState.User, UserRole.User);
            _canAdmin = HasRole(authState.User, UserRole.Admin);

            // A department head edits only the departments assigned to them; load that scope so the
            // UI can show edit controls for those departments (server-side guards enforce it too).
            _managedDeptIds.Clear();
            if (!_canEdit)
            {
                try
                {
                    foreach (var id in await HeadService.GetManagedDepartmentIdsAsync())
                    {
                        _managedDeptIds.Add(id);
                    }
                }
                catch { /* scope is a UI aid; server-side guards are the control */ }
            }

            // Open on the shift running now, not a day+night pool that would count the off-shift
            // as absent. Resolved once so a manual shift choice survives in-page interactions.
            if (!_shiftInitialised)
            {
                try { _shift = await DashboardService.GetLiveShiftAsync(); }
                catch { _shift = ShiftFilter.Day; }
                _shiftInitialised = true;
            }

            _busy = true;
            try { await LoadAsync(); }
            finally { _busy = false; }
        }
        else
        {
            _division = null;
        }
    }

    private async Task OnShiftChanged(ShiftFilter shift)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            _shift = shift;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadAsync()
    {
        if (_division is null)
        {
            return;
        }

        _dashboard = await DashboardService.GetDivisionDashboardAsync(_division.Value, _shift);
        _departments = (await DepartmentService.GetByDivisionAsync(_division.Value)).ToList();
        _pools = (await DepartmentService.GetPoolsAsync()).ToList();
        _allDepartments = (await DepartmentService.GetAllAsync()).ToList();
        _employees = (await EmployeeService.GetByDivisionAsync(_division.Value)).ToList();
        _schedules = await ScheduleService.ListAsync();

        _byDept = _employees
            .Where(MatchesShift)
            .GroupBy(e => e.DepartmentId)
            .ToDictionary(g => g.Key, g => g.ToList());

        // Department-wise outsource lines for the "Outsource by department" panel: bold department,
        // right-aligned present/assigned. Busiest departments first.
        _outsourceByDept = _employees
            .Where(MatchesShift)
            .Where(e => e.IsSupply)
            .GroupBy(e => e.DepartmentName)
            .Select(g => new
            {
                Department = g.Key,
                Present = g.Count(x => x.Status == AttendanceStatus.Present),
                Total = g.Count()
            })
            .OrderByDescending(x => x.Present)
            .ThenBy(x => x.Department)
            .Select(x => $"{TextCase.Title(x.Department)} · {x.Present}/{x.Total}")
            .ToList();
    }

    private bool MatchesShift(EmployeeDto e) => _shift switch
    {
        ShiftFilter.Day => e.Shift == ShiftType.Day,
        ShiftFilter.Night => e.Shift == ShiftType.Night,
        _ => true
    };

    private IEnumerable<DepartmentStats> VisibleDepartments()
    {
        if (_dashboard is null)
        {
            return Enumerable.Empty<DepartmentStats>();
        }

        return _dashboard.Departments.Where(d =>
            (string.IsNullOrWhiteSpace(_search) || d.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
            && _filter switch
            {
                "short" => d.Status == DepartmentStaffingStatus.Short,
                "excess" => d.Status == DepartmentStaffingStatus.Excess,
                "ok" => d.Status == DepartmentStaffingStatus.Optimal,
                "off" => d.Status == DepartmentStaffingStatus.Off,
                _ => true
            });
    }

    private static string StatusLabel(DepartmentStats d) => d.Status switch
    {
        DepartmentStaffingStatus.Short => $"Short {d.Variance}",
        DepartmentStaffingStatus.Excess => $"Excess +{d.Variance}",
        DepartmentStaffingStatus.Off => "OFF",
        _ => "Optimal"
    };

    private List<string> AbsentList() =>
        _employees.Where(MatchesShift).Where(e => !e.IsSupply && e.Status == AttendanceStatus.Absent)
            .Select(e => $"{TextCase.Title(e.Name)} · {TextCase.Title(e.DepartmentName)}").ToList();

    private List<string> VacationList() =>
        _employees.Where(MatchesShift).Where(e => !e.IsSupply && e.Status == AttendanceStatus.OnVacation)
            .Select(e => $"{TextCase.Title(e.Name)} · {TextCase.Title(e.DepartmentName)}").ToList();

    private List<string> OutsourceList() =>
        _employees.Where(MatchesShift).Where(e => e.IsSupply && e.Status == AttendanceStatus.Present)
            .Select(e => $"{TextCase.Title(e.Name)} · {TextCase.Title(e.DepartmentName)}").ToList();

    private List<string> ExcessList()
    {
        var result = new List<string>();
        if (_dashboard is null)
        {
            return result;
        }

        foreach (var dept in _dashboard.Departments)
        {
            if (!_byDept.TryGetValue(dept.DepartmentId, out var members))
            {
                continue;
            }

            if (dept.Status == DepartmentStaffingStatus.Off)
            {
                result.AddRange(members.Where(e => e.Status == AttendanceStatus.Present)
                    .Select(e => $"{TextCase.Title(e.Name)} · {TextCase.Title(dept.Name)} (dept OFF)"));
            }
            else if (dept.Variance > 0)
            {
                result.Add($"{TextCase.Title(dept.Name)}: {dept.Variance} over required");
            }
        }

        return result;
    }

    /// <summary>Fixed department tile accent, cycling the Fluent token palette by department id.</summary>
    private static readonly string[] DeptPalette = { "#0F6CBD", "#038387", "#5C2E91", "#986F0B", "#C239B3", "#0E700E" };
    private static string DeptAccent(int departmentId) => DeptPalette[Math.Abs(departmentId) % DeptPalette.Length];

    /// <summary>Renders a surplus with an explicit "+" so it isn't ambiguous next to a shortage.</summary>
    private static string Signed(int value) => value > 0 ? $"+{value}" : value.ToString();

    /// <summary>Label for the current shift filter, used in the department subtitle.</summary>
    private string ShiftText() => _shift switch
    {
        ShiftFilter.Day => "day shift",
        ShiftFilter.Night => "night shift",
        _ => "all shifts"
    };

    private bool IsExpanded(int departmentId) => _expanded.Contains(departmentId);

    private void ToggleExpand(int departmentId)
    {
        if (!_expanded.Remove(departmentId))
        {
            _expanded.Add(departmentId);
        }
    }

    private async Task SetStatusAsync(int employeeId, AttendanceStatus status)
    {
        await RunActionAsync(() => EmployeeService.ChangeStatusAsync(employeeId, new ChangeStatusRequest { Status = status }));
    }

    private async Task ChangeShiftAsync(int employeeId, ShiftType shift)
    {
        await RunActionAsync(() => EmployeeService.ChangeShiftAsync(employeeId, new ChangeShiftRequest { Shift = shift }));
    }

    private async Task MoveAsync(int employeeId, string? rawTargetDepartmentId)
    {
        // The placeholder option carries "0"; ignore it and any unparseable value so an
        // accidental re-selection does not issue a no-op move (and its spurious audit entry).
        if (!int.TryParse(rawTargetDepartmentId, out var targetDepartmentId) || targetDepartmentId == 0)
        {
            return;
        }

        await RunActionAsync(() => EmployeeService.MoveAsync(employeeId, new MoveEmployeeRequest { TargetDepartmentId = targetDepartmentId }));
    }

    private async Task ToggleDepartmentAsync(int departmentId, bool isActive)
    {
        await RunActionAsync(() => DepartmentService.SetActiveAsync(departmentId, isActive));
    }

    private async Task ToggleAllAsync(bool active)
    {
        await RunActionAsync(async () =>
        {
            foreach (var d in _departments)
            {
                if (d.IsActive != active)
                {
                    await DepartmentService.SetActiveAsync(d.Id, active);
                }
            }
        });
    }

    /// <summary>
    /// Runs a data-changing action, reloads the view, and surfaces any service error inline
    /// instead of letting the exception tear down the Blazor circuit (which would white-screen
    /// the page and lose all state). The view is always reloaded so the UI reflects true state.
    /// </summary>
    private bool _busy;

    private async Task RunActionAsync(Func<Task> action)
    {
        // Serialise DB work: the EF context is scoped to the whole circuit, so a second overlapping
        // action would reuse it mid-query and crash the circuit. Drop an action if one is running.
        if (_busy)
        {
            return;
        }

        _busy = true;
        _actionError = null;
        try
        {
            try { await action(); }
            catch (Exception ex) { _actionError = ex.Message; }
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _actionError ??= ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenAddDept()
    {
        _editingId = null;
        _fName = string.Empty;
        _fReqDay = 0;
        _fReqNight = 0;
        _fSeq = 9999m;
        _fActive = true;
        // Default to the first schedule so the dropdown is never blank.
        _fScheduleId = _schedules.FirstOrDefault()?.Id ?? 0;
        _formError = null;
        _showDeptForm = true;
    }

    private void OpenEditDept(int departmentId)
    {
        var dept = _departments.FirstOrDefault(d => d.Id == departmentId);
        if (dept is null)
        {
            return;
        }

        _editingId = dept.Id;
        _fName = dept.Name;
        _fReqDay = dept.RequiredDay;
        _fReqNight = dept.RequiredNight;
        _fSeq = dept.Sequence;
        _fActive = dept.IsActive;
        _fScheduleId = dept.ShiftScheduleId;
        _formError = null;
        _showDeptForm = true;
    }

    private void CloseDeptForm() => _showDeptForm = false;

    private async Task SaveDeptAsync()
    {
        if (_division is null || _busy)
        {
            return;
        }

        _busy = true;
        _formError = null;
        try
        {
            if (_editingId is null)
            {
                await DepartmentService.CreateAsync(new CreateDepartmentRequest
                {
                    Division = _division.Value,
                    Name = _fName,
                    RequiredDay = _fReqDay,
                    RequiredNight = _fReqNight,
                    Sequence = _fSeq,
                    ShiftScheduleId = _fScheduleId
                });
            }
            else
            {
                await DepartmentService.UpdateAsync(_editingId.Value, new UpdateDepartmentRequest
                {
                    RequiredDay = _fReqDay,
                    RequiredNight = _fReqNight,
                    Sequence = _fSeq,
                    IsActive = _fActive,
                    ShiftScheduleId = _fScheduleId
                });
            }

            _showDeptForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private DepartmentStats? _deleteDeptTarget;

    private async Task ConfirmDeleteDeptAsync()
    {
        if (_deleteDeptTarget is null || _busy)
        {
            return;
        }

        _busy = true;
        _actionError = null;
        var id = _deleteDeptTarget.DepartmentId;
        try
        {
            // Force-delete handles every safe case uniformly: a truly empty department, one that only
            // holds outsource/supply members, and one still referenced as someone's home department
            // (they are re-homed). It refuses server-side if any own staff are allocated.
            await DepartmentService.ForceDeleteAsync(id);
            _deleteDeptTarget = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            // Surface via _actionError (always rendered), not _formError (only shown in the form modal).
            _deleteDeptTarget = null;
            _actionError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenDeptModal(DepartmentStats dept) => _modalDept = dept;

    /// <summary>A User/Admin may edit any department; a department head only their assigned ones.</summary>
    private bool CanEditDept(int departmentId) => _canEdit || _managedDeptIds.Contains(departmentId);

    /// <summary>Short division label for the pool loan-target optgroups.</summary>
    private static string DivisionLabel(Division division) => division switch
    {
        Division.Egl => "EGL",
        Division.FunctionalSupport => "Functional Support",
        Division.Brg => "BRG",
        _ => division.ToString()
    };

    /// <summary>Editing a department’s requirements: Admin anywhere, or a head within their scope.</summary>
    private bool CanManageDept(int departmentId) => _canAdmin || _managedDeptIds.Contains(departmentId);

    private static bool HasRole(System.Security.Claims.ClaimsPrincipal user, UserRole minimum)
    {
        var raw = user.FindFirst(AppClaimTypes.AppRole)?.Value;
        // DepartmentHead ranks only as Viewer on the global ladder (its powers are scoped per department).
        return Enum.TryParse<UserRole>(raw, out var role) && RoleRank.RankOf(role) >= RoleRank.RankOf(minimum);
    }
}
