@page "/"
@using ManpowerAllocation.Application.Dashboard
@using ManpowerAllocation.Application.Employees
@using ManpowerAllocation.Web.Security
@attribute [Authorize(Policy = AuthorizationPolicies.RequireViewer)]
@inject IDashboardService DashboardService
@inject IEmployeeService EmployeeService
@inject NavigationManager Navigation

<PageTitle>Summary — Manpower Allocation</PageTitle>

<div class="screen-head">
    <h1>Factory Summary</h1>
    <ShiftSelector Value="_shift" ValueChanged="OnShiftChanged" />
</div>

<div class="toolbar">
    <span class="hint">Export:</span>
    <FluentAnchor Href="api/exports/report" Target="_blank" Appearance="Appearance.Neutral">Staffing report</FluentAnchor>
    <FluentAnchor Href="api/exports/attendance" Target="_blank" Appearance="Appearance.Neutral">Attendance</FluentAnchor>
    <FluentAnchor Href="api/exports/requirements-template" Target="_blank" Appearance="Appearance.Neutral">Requirements template</FluentAnchor>
</div>

@if (!_loaded)
{
    <p><em>Loading…</em></p>
}
else
{
    <div class="card-row">
        @foreach (var d in _divisions)
        {
            var presentPct = d.Required > 0 ? Math.Min((int)Math.Round(d.Present * 100.0 / d.Required), 100) : (d.Present > 0 ? 100 : 0);
            var supplyPct = d.Required > 0 ? Math.Min((int)Math.Round(d.SupplyPresent * 100.0 / d.Required), 100 - presentPct) : 0;
            <div class="stat-card d-@d.Division.ToString().ToLowerInvariant()" role="button" tabindex="0"
                 @onclick="() => Go(d.Division)"
                 @onkeydown="e => OnCardKey(e, d.Division)"
                 aria-label="@($"Open {DivisionLabel(d.Division)} division")">
                <div class="stat-card-head">
                    <span class="stat-tile" style="background:@DivAccent(d.Division)">@DivInitials(d.Division)</span>
                    <div class="stat-card-title">@DivisionLabel(d.Division)</div>
                    <span class="stat-open">Open →</span>
                </div>
                <div class="stat-card-big @(d.Variance < 0 ? "negative" : "positive")">@d.TotalPresent <span class="stat-of">present of @d.Required required</span></div>
                <div class="bar">
                    <div class="bar-fill @(d.Variance < 0 ? "fill-short" : "fill-optimal")" style="width:@(presentPct)%"></div>
                    @if (d.SupplyPresent > 0) { <div class="bar-supply" style="width:@(supplyPct)%"></div> }
                </div>
                <div class="badges">
                    <span class="badge b-off">On roll @d.OnRoll</span>
                    @if (d.Absent > 0) { <span class="badge b-short">Absent @d.Absent</span> }
                    @if (d.OnVacation > 0) { <span class="badge b-vac">Vacation @d.OnVacation</span> }
                    @if (d.SupplyPresent > 0) { <span class="badge b-supply">Outsource @d.SupplyPresent</span> }
                    <span class="badge @(d.Variance < 0 ? "b-short" : "b-optimal")">Variance @d.Variance</span>
                    @if (d.ShortageDepartmentCount > 0) { <span class="badge b-short">Short depts @d.ShortageDepartmentCount</span> }
                </div>
            </div>
        }
    </div>

    <div class="@($"factory-total {(FactoryVariance < 0 ? "negative" : "positive")}")">
        <div class="ft-row">
            <div>
                <div class="ft-lbl">Factory total present</div>
                <div class="ft-num @(FactoryVariance < 0 ? "negative" : "positive")">@FactoryPresent <span class="stat-of">/ @FactoryRequired required</span></div>
            </div>
            <span class="badge @(FactoryVariance < 0 ? "b-short" : "b-optimal")">Variance @FactoryVariance</span>
            <span class="dc-spacer"></span>
            <span class="ft-scope">@ScopeText()</span>
        </div>
    </div>

    <div class="sum-panel">
        <div class="sum-panel-title">Division breakdown</div>
        <div class="grid-scroll">
            <table class="grid">
                <thead>
                    <tr><th>Division</th><th class="num">On roll</th><th class="num">Present</th><th class="num">Absent</th><th class="num">Vacation</th><th class="num">Outsource</th><th class="num">Required</th><th class="num">Variance</th></tr>
                </thead>
                <tbody>
                    @foreach (var d in _divisions)
                    {
                        <tr>
                            <td><span class="cell-accent" style="background:@DivAccent(d.Division)"></span>@DivisionLabel(d.Division)</td>
                            <td class="num">@d.OnRoll</td>
                            <td class="num">@d.TotalPresent</td>
                            <td class="num">@d.Absent</td>
                            <td class="num">@d.OnVacation</td>
                            <td class="num">@d.SupplyPresent</td>
                            <td class="num">@d.Required</td>
                            <td class="num strong @(d.Variance < 0 ? "negative" : "positive")">@d.Variance</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="alert-row">
        <AlertPanel Title="Absent today" Accent="red" Items="_absent" />
        <AlertPanel Title="On vacation" Accent="amber" Items="_vacation" />
        <AlertPanel Title="Shortage departments" Accent="cyan" Items="_shortage" />
        <AlertPanel Title="Outsource present" Accent="purple" Items="_outsource" />
    </div>
}

@code {
    private ShiftFilter _shift = ShiftFilter.All;
    private bool _loaded;
    private readonly List<DivisionTotals> _divisions = new();
    private List<string> _absent = new();
    private List<string> _vacation = new();
    private List<string> _outsource = new();
    private List<string> _shortage = new();

    private int FactoryPresent => _divisions.Sum(d => d.TotalPresent);
    private int FactoryRequired => _divisions.Sum(d => d.Required);
    private int FactoryVariance => FactoryPresent - FactoryRequired;

    /// <summary>Loads the summary on first render.</summary>
    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnShiftChanged(ShiftFilter shift)
    {
        _shift = shift;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _divisions.Clear();
        _absent = new();
        _vacation = new();
        _outsource = new();
        _shortage = new();

        foreach (var division in Enum.GetValues<Division>())
        {
            var dashboard = await DashboardService.GetDivisionDashboardAsync(division, _shift);
            _divisions.Add(dashboard.Totals);

            _shortage.AddRange(dashboard.Departments
                .Where(d => d.Status == DepartmentStaffingStatus.Short)
                .Select(d => $"{TextCase.Title(d.Name)} · {DivisionLabel(division)} ({d.Variance})"));

            var employees = (await EmployeeService.GetByDivisionAsync(division)).Where(MatchesShift).ToList();
            _absent.AddRange(employees.Where(e => !e.IsSupply && e.Status == AttendanceStatus.Absent)
                .Select(e => $"{TextCase.Title(e.Name)} · {TextCase.Title(e.DepartmentName)}"));
            _vacation.AddRange(employees.Where(e => !e.IsSupply && e.Status == AttendanceStatus.OnVacation)
                .Select(e => $"{TextCase.Title(e.Name)} · {TextCase.Title(e.DepartmentName)}"));
            _outsource.AddRange(employees.Where(e => e.IsSupply && e.Status == AttendanceStatus.Present)
                .Select(e => $"{TextCase.Title(e.Name)} · {TextCase.Title(e.DepartmentName)}"));
        }

        _loaded = true;
    }

    private bool MatchesShift(EmployeeDto e) => _shift switch
    {
        ShiftFilter.Day => e.Shift == ShiftType.Day,
        ShiftFilter.Night => e.Shift == ShiftType.Night,
        _ => true
    };

    private void Go(Division division) => Navigation.NavigateTo($"division/{division}");

    /// <summary>Activates a division stat-card with the keyboard (Enter or Space).</summary>
    private void OnCardKey(KeyboardEventArgs e, Division division)
    {
        if (e.Key is "Enter" or " ")
        {
            Go(division);
        }
    }

    private static string DivisionLabel(Division division) => division switch
    {
        Division.Egl => "EGL",
        Division.FunctionalSupport => "Functional Support",
        Division.Brg => "BRG",
        _ => division.ToString()
    };

    /// <summary>Division identity accent (matches the nav tile and the division page).</summary>
    private static string DivAccent(Division division) => division switch
    {
        Division.Egl => "var(--brand)",
        Division.FunctionalSupport => "var(--info)",
        Division.Brg => "var(--magenta)",
        _ => "var(--brand)"
    };

    /// <summary>Short initials for the division tile.</summary>
    private static string DivInitials(Division division) => division switch
    {
        Division.Egl => "EG",
        Division.FunctionalSupport => "FS",
        Division.Brg => "BRG",
        _ => "•"
    };

    /// <summary>Human label for the current shift scope, shown on the factory-total caption.</summary>
    private string ScopeText() => _shift switch
    {
        ShiftFilter.Day => "Day shift",
        ShiftFilter.Night => "Night shift",
        _ => "All shifts"
    };
}
