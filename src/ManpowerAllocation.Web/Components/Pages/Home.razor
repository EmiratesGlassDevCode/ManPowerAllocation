@page "/"
@using ManpowerAllocation.Application.Dashboard
@using ManpowerAllocation.Application.Employees
@using ManpowerAllocation.Web.Security
@attribute [Authorize(Policy = AuthorizationPolicies.RequireViewer)]
@inject IDashboardService DashboardService
@inject IEmployeeService EmployeeService
@inject NavigationManager Navigation

<PageTitle>Summary — Manpower Allocation</PageTitle>

<div class="screen-head">
    <h1>Factory Summary</h1>
    <ShiftSelector Value="_shift" ValueChanged="OnShiftChanged" />
</div>

<div class="toolbar">
    <span class="hint">Export:</span>
    <a class="btn-link" href="api/exports/report" target="_blank">Staffing report</a>
    <a class="btn-link" href="api/exports/attendance" target="_blank">Attendance</a>
    <a class="btn-link" href="api/exports/requirements-template" target="_blank">Requirements template</a>
</div>

@if (!_loaded)
{
    <p><em>Loading…</em></p>
}
else
{
    <div class="card-row">
        @foreach (var d in _divisions)
        {
            <div class="stat-card" role="button" tabindex="0"
                 @onclick="() => Go(d.Division)"
                 @onkeydown="e => OnCardKey(e, d.Division)"
                 aria-label="@($"Open {DivisionLabel(d.Division)} division")">
                <div class="stat-card-title">@DivisionLabel(d.Division)</div>
                <div class="stat-card-big">@d.TotalPresent</div>
                <div class="stat-card-sub">Present of @d.Required required</div>
                <div class="stat-card-line">On roll: @d.OnRoll &nbsp; Absent: @d.Absent &nbsp; Vacation: @d.OnVacation</div>
                <div class="stat-card-line">Outsource present: @d.SupplyPresent</div>
                <div class="stat-card-line @(d.Variance < 0 ? "negative" : "positive")">
                    Variance: @d.Variance &nbsp; Shortage depts: @d.ShortageDepartmentCount
                </div>
            </div>
        }
    </div>

    <div class="factory-total @(FactoryVariance < 0 ? "negative" : "positive")">
        <strong>Factory total present:</strong> @FactoryPresent / required @FactoryRequired (net variance @FactoryVariance)
    </div>

    <div class="sum-panel">
        <div class="sum-panel-title">◆ Division breakdown</div>
        <table class="grid">
            <thead>
                <tr><th>Division</th><th>On roll</th><th>Present</th><th>Absent</th><th>Vacation</th><th>Outsource</th><th>Required</th><th>Variance</th></tr>
            </thead>
            <tbody>
                @foreach (var d in _divisions)
                {
                    <tr>
                        <td>@DivisionLabel(d.Division)</td>
                        <td>@d.OnRoll</td>
                        <td>@d.TotalPresent</td>
                        <td>@d.Absent</td>
                        <td>@d.OnVacation</td>
                        <td>@d.SupplyPresent</td>
                        <td>@d.Required</td>
                        <td class="@(d.Variance < 0 ? "negative" : "positive")">@d.Variance</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="alert-row">
        <AlertPanel Title="⚠ Absent today" Accent="red" Items="_absent" />
        <AlertPanel Title="☀ On vacation" Accent="amber" Items="_vacation" />
    </div>
    <div class="alert-row">
        <AlertPanel Title="▼ Shortage departments" Accent="red" Items="_shortage" />
        <AlertPanel Title="◆ Outsource present" Accent="purple" Items="_outsource" />
    </div>
}

@code {
    private ShiftFilter _shift = ShiftFilter.All;
    private bool _loaded;
    private readonly List<DivisionTotals> _divisions = new();
    private List<string> _absent = new();
    private List<string> _vacation = new();
    private List<string> _outsource = new();
    private List<string> _shortage = new();

    private int FactoryPresent => _divisions.Sum(d => d.TotalPresent);
    private int FactoryRequired => _divisions.Sum(d => d.Required);
    private int FactoryVariance => FactoryPresent - FactoryRequired;

    /// <summary>Loads the summary on first render.</summary>
    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnShiftChanged(ShiftFilter shift)
    {
        _shift = shift;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _divisions.Clear();
        _absent = new();
        _vacation = new();
        _outsource = new();
        _shortage = new();

        foreach (var division in Enum.GetValues<Division>())
        {
            var dashboard = await DashboardService.GetDivisionDashboardAsync(division, _shift);
            _divisions.Add(dashboard.Totals);

            _shortage.AddRange(dashboard.Departments
                .Where(d => d.Status == DepartmentStaffingStatus.Short)
                .Select(d => $"{d.Name} · {DivisionLabel(division)} ({d.Variance})"));

            var employees = (await EmployeeService.GetByDivisionAsync(division)).Where(MatchesShift).ToList();
            _absent.AddRange(employees.Where(e => !e.IsSupply && e.Status == AttendanceStatus.Absent)
                .Select(e => $"{e.Name} · {e.DepartmentName}"));
            _vacation.AddRange(employees.Where(e => !e.IsSupply && e.Status == AttendanceStatus.OnVacation)
                .Select(e => $"{e.Name} · {e.DepartmentName}"));
            _outsource.AddRange(employees.Where(e => e.IsSupply && e.Status == AttendanceStatus.Present)
                .Select(e => $"{e.Name} · {e.DepartmentName}"));
        }

        _loaded = true;
    }

    private bool MatchesShift(EmployeeDto e) => _shift switch
    {
        ShiftFilter.Day => e.Shift == ShiftType.Day,
        ShiftFilter.Night => e.Shift == ShiftType.Night,
        _ => true
    };

    private void Go(Division division) => Navigation.NavigateTo($"division/{division}");

    /// <summary>Activates a division stat-card with the keyboard (Enter or Space).</summary>
    private void OnCardKey(KeyboardEventArgs e, Division division)
    {
        if (e.Key is "Enter" or " ")
        {
            Go(division);
        }
    }

    private static string DivisionLabel(Division division) => division switch
    {
        Division.Egl => "EGL",
        Division.FunctionalSupport => "Functional Support",
        Division.Brg => "BRG",
        _ => division.ToString()
    };
}
