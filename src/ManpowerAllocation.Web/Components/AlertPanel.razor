@*
    Reusable coloured list panel used for Absent / Vacation / Outsource / Excess / Shortage
    summaries. Shows a count badge and the items, or a muted "None" when empty.
*@
<div class="@($"glass alert-panel accent-{Accent}")">
    <div class="alert-head">
        <span>@Title</span>
        <FluentBadge Appearance="Appearance.Neutral">@(Items?.Count ?? 0)</FluentBadge>
    </div>
    @if (Items is null || Items.Count == 0)
    {
        <div class="alert-empty">None</div>
    }
    else
    {
        <ul class="alert-items">
            @foreach (var item in Items)
            {
                var sep = item.IndexOf(" · ", StringComparison.Ordinal);
                var name = sep >= 0 ? item[..sep] : item;
                var detail = sep >= 0 ? item[(sep + 3)..] : string.Empty;
                <li>
                    <span class="av" style="background:@ManpowerAllocation.Web.Common.Avatar.Color(name)">@ManpowerAllocation.Web.Common.Avatar.Initials(name)</span>
                    <span class="av-name">@name</span>
                    <span class="av-dept">@detail</span>
                </li>
            }
        </ul>
    }
</div>

@code {
    /// <summary>Panel heading.</summary>
    [Parameter] public string Title { get; set; } = string.Empty;

    /// <summary>Accent colour keyword (red / amber / purple / cyan / green).</summary>
    [Parameter] public string Accent { get; set; } = "red";

    /// <summary>The lines to display.</summary>
    [Parameter] public List<string>? Items { get; set; }
}
