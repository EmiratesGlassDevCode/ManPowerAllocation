@using ManpowerAllocation.Web.Common
@*
    Reusable list panel used for Absent / Vacation / Outsource / Excess / Shortage summaries.
    The header carries an accent square + count; each row shows a status-tinted avatar (tinted
    by the panel accent), the person and a right-aligned context. Empty state is explicit.
*@
<div class="@($"alert-panel accent-{Accent}")">
    <div class="alert-head">
        <span class="alert-ico"></span>
        <span class="alert-title">@Title</span>
        <span class="count">@(Items?.Count ?? 0)</span>
    </div>
    @if (Items is null || Items.Count == 0)
    {
        <div class="alert-empty">Nothing to report.</div>
    }
    else
    {
        <ul class="alert-items">
            @foreach (var item in Items)
            {
                var sep = item.IndexOf(" · ", StringComparison.Ordinal);
                var name = sep >= 0 ? item[..sep] : item;
                var detail = sep >= 0 ? item[(sep + 3)..] : string.Empty;
                <li>
                    <span class="av">@Avatar.Initials(name)</span>
                    <span class="av-name">@name</span>
                    <span class="av-dept">@detail</span>
                </li>
            }
        </ul>
    }
</div>

@code {
    /// <summary>Panel heading.</summary>
    [Parameter] public string Title { get; set; } = string.Empty;

    /// <summary>Accent colour keyword (red / amber / purple / cyan / green).</summary>
    [Parameter] public string Accent { get; set; } = "red";

    /// <summary>The lines to display.</summary>
    [Parameter] public List<string>? Items { get; set; }
}
